import React, { useState, useEffect, useRef } from 'react';
import { motion, AnimatePresence } from 'motion/react';
import { 
  ShieldCheck, 
  ArrowLeft, 
  Send, 
  Paperclip, 
  Smile, 
  MessageSquare, 
  User, 
  Users,
  Bell,
  Search,
  Check, 
  CheckCheck,
  Zap,
  PhoneCall,
  Loader2,
  X,
  MapPin,
  Globe,
  Phone,
  UserMinus,
  Plus,
  Trash2,
  CheckSquare,
  Square,
  Pencil,
  MoreVertical,
  Ban
} from 'lucide-react';

// Date formatting helpers
const formatTime = (dateString: string) => {
  const date = new Date(dateString);
  return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
};

const formatDateSeparator = (dateString: string) => {
  const date = new Date(dateString);
  const now = new Date();
  const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const yesterday = new Date(today);
  yesterday.setDate(yesterday.getDate() - 1);

  const messageDate = new Date(date.getFullYear(), date.getMonth(), date.getDate());

  if (messageDate.getTime() === today.getTime()) {
    return 'Today';
  } else if (messageDate.getTime() === yesterday.getTime()) {
    return 'Yesterday';
  } else {
    return date.toLocaleDateString([], { 
      weekday: 'long', 
      year: 'numeric', 
      month: 'long', 
      day: 'numeric' 
    });
  }
};
import { 
  fetchContacts, 
  Profile,
  getLocalMessages,
  sendLocalMessage,
  Message,
  fetchFriendRequests,
  sendFriendRequest,
  acceptFriendRequest,
  rejectFriendRequest,
  cancelFriendRequest,
  fetchSentFriendRequests,
  unfriend,
  addMessageReaction,
  deleteMessages,
  clearChat,
  clearAllChats,
  blockUser,
  unblockUser,
  fetchBlockedUsers,
  isFriend,
  markMessagesAsRead,
  markSingleMessageAsRead,
  updateMessageContent
} from '../lib/chat';
import { supabase } from '../lib/supabase';
import { getInitials, getAvatarColorClass } from '../lib/avatar';
import { playNotificationSound } from '../lib/sound';
import { sendDesktopNotification } from '../lib/notifications';
import { EMOJI_CATEGORIES } from '../lib/emojis';

interface UserProfile {
  id: string;
  name: string;
  email: string;
  status: string;
  avatar_url?: string;
  bio?: string;
  username?: string;
}

interface ChatViewProps {
  userId: string;
  activeContactId?: string | null;
  setActiveContactId?: (id: string | null) => void;
  profileToView?: Profile | null;
  setProfileToView?: (profile: Profile | null) => void;
  myProfile?: any;
  key?: string;
  onClose?: () => void;
  setFullScreenImage: (url: string | null) => void;
  onRefreshCounts?: () => void;
}

export function ChatView({ userId, activeContactId: propActiveContactId, setActiveContactId: propSetActiveContactId, profileToView, setProfileToView, myProfile, onClose, setFullScreenImage, onRefreshCounts }: ChatViewProps) {
  const [internalActiveContactId, setInternalActiveContactId] = useState<string | null>(null);
  const activeContactId = propActiveContactId !== undefined ? propActiveContactId : internalActiveContactId;
  const setActiveContactId = propSetActiveContactId || setInternalActiveContactId;

  const [subTab, setSubTab] = useState<'Chats' | 'Contacts' | 'Requests' | 'Discover'>('Chats');
  const [contacts, setContacts] = useState<any[]>([]);
  const [profiles, setProfiles] = useState<UserProfile[]>([]);
  const [loadingProfiles, setLoadingProfiles] = useState(false);
  const [search, setSearch] = useState('');
  const [activeProfile, setActiveProfile] = useState<any>(null);
  const [users, setUsers] = useState<Profile[]>([]);
  const [loading, setLoading] = useState(false);
  const [lastActivity, setLastActivity] = useState(Date.now());
  const [showProfileDetails, setShowProfileDetails] = useState<Profile | null>(null);
  const [blockedUsers, setBlockedUsers] = useState<string[]>([]);

  useEffect(() => {
    if (profileToView) {
      setShowProfileDetails(profileToView);
      if (setProfileToView) {
        setProfileToView(null);
      }
    }
  }, [profileToView, setProfileToView]);

  const [incomingRequests, setIncomingRequests] = useState<any[]>([]);
  const [sentRequests, setSentRequests] = useState<any[]>([]);
  const [toast, setToast] = useState<{ message: string; type: 'success' | 'info' | 'error' } | null>(null);
  const [unfriendConfirmId, setUnfriendConfirmId] = useState<string | null>(null);

  useEffect(() => {
    const interval = setInterval(() => setLastActivity(Date.now()), 1000);
    return () => clearInterval(interval);
  }, []);

  const [currentUserProfile, setCurrentUserProfile] = useState<any>(null);

  const fetchCurrentUserProfile = async () => {
    try {
      const { data } = await supabase
        .from('profiles')
        .select('*')
        .eq('id', userId)
        .maybeSingle();
        
      const localExtra = localStorage.getItem(`profile_extra_${userId}`);
      const parsedLocal = localExtra ? JSON.parse(localExtra) : {};
      
      const fallbackName = parsedLocal.name || 'Me';
      const fallbackAvatar = parsedLocal.avatar_url || '';
      
      if (data) {
        setCurrentUserProfile({
          ...data,
          name: data.name || fallbackName,
          avatar_url: data.avatar_url || fallbackAvatar
        });
      } else {
        setCurrentUserProfile({
          id: userId,
          name: fallbackName,
          avatar_url: fallbackAvatar
        });
      }
    } catch (err) {
      console.warn('Error loading current user profile inside ChatView:', err);
    }
  };

  useEffect(() => {
    if (myProfile) {
      setCurrentUserProfile(myProfile);
    } else if (userId) {
      fetchCurrentUserProfile();
    }
  }, [userId, myProfile]);

  useEffect(() => {
    if (toast) {
      if (toast.type !== 'error') {
        playNotificationSound('notification');
      }
      const timer = setTimeout(() => setToast(null), 4000);
      return () => clearTimeout(timer);
    }
  }, [toast]);
  
  // Message input state
  const [messageText, setMessageText] = useState('');
  const [activeMessages, setActiveMessages] = useState<Message[]>([]);
  
  const messagesEndRef = useRef<HTMLDivElement>(null);
  const containerRef = useRef<HTMLDivElement>(null);
  const lastKnownMessageIdRef = useRef<string | null>(null);
  const lastReactionUpdateRef = useRef<number>(0);

  // Emoji picker states
  const [showEmojiPicker, setShowEmojiPicker] = useState(false);
  const [emojiSearch, setEmojiSearch] = useState('');
  const [activeEmojiTab, setActiveEmojiTab] = useState('Smileys');
  const [isSelectionMode, setIsSelectionMode] = useState(false);
  const [selectedMessageIds, setSelectedMessageIds] = useState<Set<string>>(new Set());
  const [editingMessageId, setEditingMessageId] = useState<string | null>(null);
  const [editingContent, setEditingContent] = useState('');

  // Reaction states
  const [reactionMessageId, setReactionMessageId] = useState<string | null>(null);
  const [menuMessageId, setMenuMessageId] = useState<string | null>(null);
  const [headerMenuOpen, setHeaderMenuOpen] = useState(false);
  const longPressTimerRef = useRef<NodeJS.Timeout | null>(null);

  const handlePointerDown = (msgId: string) => {
    if (longPressTimerRef.current) clearTimeout(longPressTimerRef.current);
    longPressTimerRef.current = setTimeout(() => {
      setReactionMessageId(msgId);
    }, 2000); 
  };

  const handleToggleSelection = (msgId: string) => {
    setSelectedMessageIds(prev => {
      const next = new Set(prev);
      if (next.has(msgId)) {
        next.delete(msgId);
      } else {
        next.add(msgId);
      }
      return next;
    });
  };

  const handleSaveEdit = async () => {
    if (!editingMessageId || !editingContent.trim()) return;
    
    try {
      await updateMessageContent(editingMessageId, editingContent);
      loadData(true);
      setEditingMessageId(null);
      setEditingContent('');
    } catch (err) {
      console.warn('Error saving edit:', err);
    }
  };

  const startEditing = (msg: Message) => {
    setEditingMessageId(msg.id);
    setEditingContent(msg.content);
    setReactionMessageId(null);
  };

  const handleDeleteSelected = async () => {
    if (selectedMessageIds.size > 0) {
      await deleteMessages(Array.from(selectedMessageIds));
      setActiveMessages(prev => prev.filter(m => !selectedMessageIds.has(m.id)));
      setSelectedMessageIds(new Set());
      setIsSelectionMode(false);
    }
  };

  const handleClearChat = async () => {
    if (activeContactId) {
      if (window.confirm("Are you sure you want to clear this chat?")) {
        await clearChat(userId, activeContactId);
        setActiveMessages([]);
      }
    }
  };

  const handleDeleteSingleMessage = async (msgId: string) => {
    await deleteMessages([msgId]);
    setActiveMessages(prev => prev.filter(m => m.id !== msgId));
    setReactionMessageId(null);
  };

  const handlePointerUp = () => {
    if (longPressTimerRef.current) clearTimeout(longPressTimerRef.current);
  };

  const handleReactionSelect = async (emoji: string, targetMessageId?: string) => {
    const msgId = targetMessageId || reactionMessageId;
    if (msgId) {
      lastReactionUpdateRef.current = Date.now();
      
      // Determine if we are adding or removing
      const msg = activeMessages.find(m => m.id === msgId);
      const isRemoving = msg?.reactions?.[userId] === emoji;
      const finalEmoji = isRemoving ? null : emoji;

      await addMessageReaction(msgId, userId, finalEmoji);

      // Optimistic update
      setActiveMessages(prev => prev.map(m => {
        if (m.id === msgId) {
          const newReactions = { ...(m.reactions || {}) };
          if (isRemoving) {
            delete newReactions[userId];
          } else {
            newReactions[userId] = emoji;
          }
          return { ...m, reactions: newReactions };
        }
        return m;
      }));
    }
    if (!targetMessageId) setReactionMessageId(null);
  };

  // Mark incoming activeMessages as read after 1.5 seconds of viewing
  useEffect(() => {
    if (!activeContactId || activeMessages.length === 0) return;

    const unreadMessages = activeMessages.filter(
      m => m.sender_id !== userId && !m.is_read
    );

    if (unreadMessages.length > 0) {
      const timer = setTimeout(() => {
        // Mark as read in DB/LocalStorage
        unreadMessages.forEach(m => markSingleMessageAsRead(m.id));
        
        // Update local state to reflect read status immediately
        setActiveMessages(prev => prev.map(m => {
          if (unreadMessages.some(um => um.id === m.id)) {
            return { ...m, is_read: true };
          }
          return m;
        }));
      }, 1500);

      return () => clearTimeout(timer);
    }
  }, [activeMessages, activeContactId, userId]);

  const handleSelectEmoji = (emoji: string) => {
    if (reactionMessageId) {
      handleReactionSelect(emoji);
      setShowEmojiPicker(false);
      return;
    }
    setMessageText(prev => prev + emoji);
  };

  const handleSendRequest = async (targetId: string) => {
    try {
      await sendFriendRequest(userId, targetId);
      setToast({ message: 'Friend request sent successfully!', type: 'success' });
      await loadData();
    } catch (e) {
      console.error('Error sending friend request:', e);
      setToast({ message: 'Error sending friend request.', type: 'error' });
    }
  };

  const handleAcceptRequest = async (requestId: string, senderId: string) => {
    try {
      await acceptFriendRequest(userId, requestId, senderId);
      
      // Send welcoming/notification message
      await sendLocalMessage(
        userId,
        senderId,
        "System: Friend request accepted! You are now connected. Say hello!"
      );
      
      setToast({ message: 'Friend request accepted! Say hello!', type: 'success' });
      
      // Auto-focus the new chat!
      setActiveContactId(senderId);
      setSubTab('Chats');
      setShowProfileDetails(null); // Close detail modal if open
      
      await loadData();
    } catch (e) {
      console.error('Error accepting friend request:', e);
      setToast({ message: 'Error accepting friend request.', type: 'error' });
    }
  };

  const handleDeclineRequest = async (requestId: string, senderId: string) => {
    try {
      await rejectFriendRequest(userId, requestId, senderId);
      setToast({ message: 'Friend request declined.', type: 'info' });
      await loadData();
    } catch (e) {
      console.error('Error declining friend request:', e);
      setToast({ message: 'Error declining friend request.', type: 'error' });
    }
  };

  const handleCancelRequest = async (targetId: string) => {
    try {
      await cancelFriendRequest(userId, targetId);
      setToast({ message: 'Friend request cancelled.', type: 'info' });
      await loadData();
    } catch (e) {
      console.error('Error cancelling friend request:', e);
      setToast({ message: 'Error cancelling friend request.', type: 'error' });
    }
  };

  const handleUnfriend = async (friendId: string) => {
    try {
      await unfriend(userId, friendId);
      setToast({ message: 'Removed from friends list.', type: 'info' });
      if (activeContactId === friendId) {
        setActiveContactId(null);
      }
      setShowProfileDetails(null);
      setUnfriendConfirmId(null);
      await loadData();
    } catch (e) {
      console.error('Error unfriending:', e);
      setToast({ message: 'Error unfriending.', type: 'error' });
    }
  };

  const getFriendshipStatus = (profileId: string) => {
    const isFriend = contacts.some(c => c.friend_id === profileId);
    if (isFriend) return { type: 'friends' as const };
    
    const incomingReq = incomingRequests.find(r => r.sender_id === profileId);
    if (incomingReq) return { type: 'incoming' as const, reqId: incomingReq.id };
    
    const outgoingReq = sentRequests.find(r => r.receiver_id === profileId);
    if (outgoingReq) return { type: 'outgoing' as const };
    
    return { type: 'none' as const };
  };

  const loadData = React.useCallback(async (silent = false) => {
    if (!silent) setLoading(true);
    try {
      // Load incoming and sent requests
      const [incoming, sent] = await Promise.all([
        fetchFriendRequests(userId),
        fetchSentFriendRequests(userId)
      ]);
      setIncomingRequests(incoming || []);
      setSentRequests(sent || []);

      if (subTab === 'Contacts' || subTab === 'Chats' || subTab === 'Discover' || subTab === 'Requests') {
        const data = await fetchContacts(userId);
        if (data && subTab === 'Chats') {
          // Fetch latest message for each contact to populate the Chats view
          const contactsWithMessages = await Promise.all(data.map(async (c) => {
            const msgs = await getLocalMessages(userId, c.friend_id);
            return {
              ...c,
              latestMsg: msgs.length > 0 ? msgs[msgs.length - 1] : undefined
            };
          }));
          setContacts(contactsWithMessages);
        } else {
          setContacts(data || []);
        }
      }
    } catch (e: any) {
      console.error('Detailed Error loading data:', {
        message: e?.message || 'Unknown error',
        code: e?.code || 'N/A',
        details: e?.details || '',
        hint: e?.hint || '',
        fullError: e
      });
    } finally {
      if (!silent) setLoading(false);
    }
  }, [userId, subTab]);

  const fetchProfiles = async (silent = false) => {
    if (!silent) setLoadingProfiles(true);
    const { data, error } = await supabase
      .from('profiles')
      .select('*')
      .eq('is_discoverable', true);
    
    if (error) {
      console.error('Error fetching profiles:', error);
    } else {
      setProfiles(data || []);
    }
    if (!silent) setLoadingProfiles(false);
  };

  useEffect(() => {
    // Initial fetch
    if (subTab === 'Discover') {
      fetchProfiles(false);
      loadData(true); // load requests silently so discover buttons show correct status
    } else {
      loadData(false);
    }

    // Subscribe to profile changes for real-time name/avatar updates
    const profileChannel = supabase
      .channel('chat-profile-updates')
      .on(
        'postgres_changes',
        { event: '*', schema: 'public', table: 'profiles' },
        () => {
          if (subTab === 'Discover') {
            fetchProfiles(true);
          }
          loadData(true);
        }
      )
      .subscribe();

    // Subscribe to messages to update unread counts and conversation list
    const messageChannel = supabase
      .channel('chat-message-updates')
      .on(
        'postgres_changes',
        { event: '*', schema: 'public', table: 'messages' },
        (payload) => {
          // If message is for us, refresh data
          if (payload.new && ((payload.new as any).receiver_id === userId || (payload.new as any).sender_id === userId)) {
            loadData(true);
          }
        }
      )
      .subscribe();

    // Keep polling as a fallback
    const interval = setInterval(() => {
      if (subTab === 'Discover') {
        fetchProfiles(true);
      }
      loadData(true);
    }, 20000); 
    
    return () => {
      clearInterval(interval);
      supabase.removeChannel(profileChannel);
      supabase.removeChannel(messageChannel);
    };
  }, [subTab, userId]);

  const filteredProfiles = profiles.filter(p => 
    p.id !== userId && !blockedUsers.includes(p.id) && (
      p.name?.toLowerCase().includes(search.toLowerCase()) || 
      p.email?.toLowerCase().includes(search.toLowerCase())
    )
  );

  // Sync active profile when contacts or activeContactId change
  useEffect(() => {
    if (!activeContactId) {
      setActiveProfile(null);
      return;
    }

    const found = contacts.find(c => c.friend_id === activeContactId);
    if (found) {
      setActiveProfile(found.profiles);
    } else {
      // If not in contacts yet (e.g. newly added), try to fetch it
      const fetchNewProfile = async () => {
        try {
          let result = await supabase
            .from('profiles')
            .select('*')
            .eq('id', activeContactId)
            .single();
          
          if (result.data) {
            setActiveProfile(result.data);
          } else {
            // No profile found
            setActiveProfile(null);
          }
        } catch (e) {
          console.warn('Could not fetch active profile:', e);
          setActiveProfile(null);
        }
      };
      fetchNewProfile();
    }
  }, [activeContactId, contacts]);

  // Reset last known message ID when contact changes to avoid playing sounds on initial load of chat history
  useEffect(() => {
    lastKnownMessageIdRef.current = null;
  }, [activeContactId]);

  // Handle active message loading & polling
  useEffect(() => {
    if (!activeContactId) {
      setActiveMessages([]);
      return;
    }

    // Initial load
    const loadMessages = async () => {
      const msgs = await getLocalMessages(userId, activeContactId);
      
      // Play a smooth sound if a new message is received from the other user
      if (msgs.length > 0) {
        const lastMsg = msgs[msgs.length - 1];
        
        if (lastKnownMessageIdRef.current !== null && lastKnownMessageIdRef.current !== lastMsg.id) {
          // It's a new message! Play sound only if it was sent by the other contact
          if (lastMsg.sender_id !== userId) {
            if (localStorage.getItem('notify_chat') !== 'false') {
              playNotificationSound('message');
              const contactName = contacts.find(c => c.friend_id === activeContactId)?.profiles?.name || 'Someone';
              sendDesktopNotification(`💬 Message from ${contactName}`, {
                body: lastMsg.content,
                tag: `chat-msg-${activeContactId}`
              });
            }
          }
        }
        
        // Update the last known message ID
        lastKnownMessageIdRef.current = lastMsg.id;
        
        // Mark messages as read when viewing them
        if (lastMsg.sender_id === activeContactId && !lastMsg.is_read) {
          await markMessagesAsRead(userId, activeContactId);
          loadData(true);
          onRefreshCounts?.();
        }
      } else {
        lastKnownMessageIdRef.current = 'none';
      }
      
      // Merge optimistic reactions if they were recently updated
      setActiveMessages(prev => {
        // Increase merge window to 30 seconds to be very safe
        const isRecentlyUpdated = Date.now() - lastReactionUpdateRef.current < 30000;
        
        if (isRecentlyUpdated) {
          return msgs.map(newMsg => {
            const oldMsg = prev.find(m => m.id === newMsg.id);
            if (oldMsg && oldMsg.reactions) {
              // Merge logic: trust local state for the current user's reaction 
              // during the merge window, but take other users' reactions from the server.
              const mergedReactions = { ...(newMsg.reactions || {}) };
              
              if (userId in oldMsg.reactions) {
                mergedReactions[userId] = oldMsg.reactions[userId];
              } else {
                // If it's missing in oldMsg (locally removed), ensure it's removed from merge
                delete mergedReactions[userId];
              }
              
              return { ...newMsg, reactions: mergedReactions };
            }
            return newMsg;
          });
        }
        return msgs;
      });
    };

    loadMessages();

    // Poll every 1 second for live feeling
    const interval = setInterval(loadMessages, 1000);
    return () => clearInterval(interval);
  }, [activeContactId, userId, contacts, loadData, onRefreshCounts]);

  // Mark all unread messages from contact as read when opening the chat
  useEffect(() => {
    const markRead = async () => {
      if (userId && activeContactId) {
        await markMessagesAsRead(userId, activeContactId);
        // Small delay to ensure Supabase propagation before refreshing UI
        setTimeout(() => {
          loadData(true);
          onRefreshCounts?.();
        }, 500);
      }
    };
    markRead();
  }, [userId, activeContactId, onRefreshCounts, loadData]);

  useEffect(() => {
    const fetchBlocked = async () => {
      const blocked = await fetchBlockedUsers(userId);
      setBlockedUsers(blocked);
    };
    fetchBlocked();
  }, [userId]);

  const handleBlockUser = async (targetId: string) => {
    console.log('[handleBlockUser] Handler called', { targetId });
    if (!window.confirm("Are you sure you want to block this user? You won't receive messages from them.")) return;
    
    // Optimistic update
    setBlockedUsers(prev => [...prev, targetId]);
    
    try {
      await blockUser(userId, targetId);
      const updated = await fetchBlockedUsers(userId);
      setBlockedUsers(updated);
      setShowProfileDetails(null);
      setActiveContactId(null);
      // Refresh contact list to hide the blocked user
      loadData(true);
      console.log('[handleBlockUser] Success');
    } catch (err: any) {
      console.error('[handleBlockUser] Error:', err);
      // Rollback
      setBlockedUsers(prev => prev.filter(id => id !== targetId));
      alert(`Failed to block user: ${err.message || err}`);
    }
  };

  const handleUnblockUser = async (targetId: string) => {
    console.log('[handleUnblockUser] Handler called', { targetId });
    
    try {
      await unblockUser(userId, targetId);
      const updated = await fetchBlockedUsers(userId);
      setBlockedUsers(updated);
      // Refresh contact list to show the unblocked user
      loadData(true);
      console.log('[handleUnblockUser] Success');
    } catch (err: any) {
      console.error('[handleUnblockUser] Error:', err);
      // alert is handled inside unblockUser library function
    }
  };

  const handleSendMessage = async (textToSend?: string) => {
    const text = textToSend !== undefined ? textToSend : messageText;
    if (!text.trim() || !activeContactId) return;

    // Check friendship
    const friends = await isFriend(userId, activeContactId);
    if (!friends) {
      alert('You must be friends to chat.');
      return;
    }

    // Check block status
    if (blockedUsers.includes(activeContactId)) {
      alert('You cannot send messages to a blocked user.');
      return;
    }

    await sendLocalMessage(userId, activeContactId, text.trim());
    if (textToSend === undefined) {
      setMessageText('');
    }
    
    setShowEmojiPicker(false);

    // Instantly append to messages for snappy visual update
    const updated = await getLocalMessages(userId, activeContactId);
    setActiveMessages(updated);
  };

  const totalUnreadMessages = contacts.reduce((sum, c) => sum + (c.unreadCount || 0), 0);

  return (
    <div className="flex flex-col flex-1 min-h-0 h-full w-full overflow-hidden">
      <motion.div
        initial={{ opacity: 0, y: 10 }}
        animate={{ opacity: 1, y: 0 }}
        className="flex flex-1 h-full w-full bg-gray-50 overflow-hidden"
      >
        {/* 1. LEFT SIDEBAR: User Profiles & Discover Section */}
        <div className={`w-full bg-white flex-col shrink-0 ${activeContactId ? 'hidden' : 'flex flex-1'}`}>
          {/* Header with Back Button */}
          {onClose && (
            <div className="h-14 border-b border-gray-200 flex items-center px-4 bg-white shrink-0">
              <button 
                onClick={onClose}
                className="flex items-center space-x-2 text-gray-500 hover:text-gray-900 transition-colors"
              >
                <ArrowLeft className="w-5 h-5" />
                <span className="font-bold text-sm">Back to App</span>
              </button>
            </div>
          )}

        {/* Navigation Sub-Tabs */}
        <div className="flex border-b border-gray-100 bg-gray-50/50 shrink-0">
          {(['Chats', 'Contacts', 'Requests', 'Discover'] as const).map((tab) => (
            <button
              key={tab}
              onClick={() => {
                setSubTab(tab);
                setActiveContactId(null); // Clear selected conversation when moving tabs
              }}
              className={`flex-1 p-3.5 text-[10px] sm:text-[11px] font-bold uppercase tracking-wider transition-all relative flex flex-col items-center justify-center gap-1 ${
                subTab === tab 
                  ? 'text-indigo-600 border-b-2 border-indigo-600 bg-white' 
                  : 'text-gray-500 hover:text-gray-800 hover:bg-gray-50'
              }`}
            >
              {tab === 'Chats' && (
                <div className="relative">
                  <MessageSquare className="w-4 h-4" />
                  {totalUnreadMessages > 0 && (
                    <span className="absolute -top-1.5 -right-1.5 bg-indigo-600 text-white font-black text-[8px] px-1 py-0.5 rounded-full flex items-center justify-center shadow-sm">
                      {totalUnreadMessages > 9 ? '9+' : totalUnreadMessages}
                    </span>
                  )}
                </div>
              )}
              {tab === 'Contacts' && <Users className="w-4 h-4" />}
              {tab === 'Requests' && (
                <div className="relative">
                  <Bell className="w-4 h-4" />
                  {incomingRequests.length > 0 && (
                    <span className="absolute -top-1.5 -right-1.5 bg-rose-500 text-white font-black text-[8px] px-1 py-0.5 rounded-full flex items-center justify-center animate-pulse shadow-sm">
                      {incomingRequests.length}
                    </span>
                  )}
                </div>
              )}
              {tab === 'Discover' && <Search className="w-4 h-4" />}
              
              <span className="mt-0.5">{tab}</span>
            </button>
          ))}
        </div>
        
        {/* Scrollable Container */}
        <div className="flex-1 overflow-y-auto p-4 space-y-3">
          {loading && (
            <div className="flex flex-col items-center justify-center h-48 space-y-2">
              <div className="animate-spin rounded-full h-7 w-7 border-b-2 border-indigo-600"></div>
              <p className="text-xs text-gray-400">Loading connections...</p>
            </div>
          )}
          
          {!loading && subTab === 'Chats' && (
            <div className="space-y-2.5">
              {contacts
                .filter(c => c.latestMsg !== undefined) // Show active chats regardless of block status
                .sort((a, b) => {
                  const timeA = a.latestMsg ? new Date(a.latestMsg.created_at).getTime() : 0;
                  const timeB = b.latestMsg ? new Date(b.latestMsg.created_at).getTime() : 0;
                  return timeB - timeA;
                })
                .map((c) => {
                  const isSelected = c.friend_id === activeContactId;
                  const latestMsg = c.latestMsg;
                  const isIncoming = latestMsg && latestMsg.sender_id !== userId;
                  const isBlocked = blockedUsers.includes(c.friend_id);
                  
                  return (
                    <div
                      key={c.friend_id}
                      onClick={() => setActiveContactId(c.friend_id)}
                      role="button"
                      tabIndex={0}
                      className={`w-full text-left p-3.5 rounded-xl transition-all flex items-center justify-between border cursor-pointer ${
                        isSelected 
                          ? 'bg-indigo-50 border-indigo-200 shadow-sm' 
                          : 'bg-white hover:bg-gray-50 border-gray-100'
                      } ${isBlocked ? 'opacity-75' : ''}`}
                    >
                      <div className="flex items-center space-x-3 min-w-0">
                        {c.profiles?.avatar_url ? (
                          <img 
                            src={c.profiles.avatar_url} 
                            alt={c.profiles.name} 
                            className={`w-10 h-10 rounded-full object-cover border border-indigo-50 cursor-pointer hover:opacity-90 transition-opacity ${isBlocked ? 'grayscale-[0.5]' : ''}`}
                            referrerPolicy="no-referrer"
                            onClick={(e) => {
                              e.stopPropagation();
                              setFullScreenImage(c.profiles.avatar_url);
                            }}
                          />
                        ) : (
                          <div className={`w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm shrink-0 border border-indigo-50 ${isBlocked ? 'bg-gray-200 text-gray-400' : getAvatarColorClass(c.profiles?.name || c.profiles?.name)}`}>
                            {getInitials(c.profiles?.name || c.profiles?.name)}
                          </div>
                        )}
                        <div className="min-w-0">
                          <div className="flex items-center space-x-1.5">
                            <p className={`font-bold text-xs sm:text-sm truncate ${isSelected ? 'text-indigo-900' : 'text-gray-900'}`}>
                              {c.profiles?.name || 'User'}
                            </p>
                            {isBlocked && (
                              <span className="bg-rose-100 text-rose-600 text-[8px] font-black uppercase px-1.5 py-0.5 rounded-full flex items-center gap-0.5 shadow-xs shrink-0">
                                <Ban className="w-2 h-2" />
                                Blocked
                              </span>
                            )}
                            {c.profiles?.status === 'Verified' && !isBlocked && (
                              <span className="inline-flex items-center shrink-0">
                                <ShieldCheck className="w-3.5 h-3.5 text-indigo-600 fill-green-50" />
                              </span>
                            )}
                          </div>
                          <p className={`text-[11px] truncate mt-0.5 ${latestMsg ? (isSelected ? 'text-indigo-600' : 'text-gray-500') : 'text-gray-400'}`}>
                            {latestMsg ? (
                              <>
                                <span className="font-semibold text-[10px] uppercase tracking-wider mr-1">
                                  {isIncoming ? 'Them:' : 'You:'}
                                </span>
                                {latestMsg.content}
                              </>
                            ) : (
                              c.profiles?.email || 'Active connection'
                            )}
                          </p>
                        </div>
                      </div>
                      {latestMsg && (
                        <div className="flex flex-col items-end space-y-1.5 shrink-0 ml-2">
                          <span className="text-[9px] text-gray-400 font-bold uppercase whitespace-nowrap">
                            {new Date(latestMsg.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
                          </span>
                          {c.unreadCount > 0 && (
                            <span className="bg-indigo-600 text-white text-[9px] font-black px-1.5 h-4 rounded-full flex items-center justify-center shadow-sm animate-in zoom-in duration-300">
                              {c.unreadCount > 9 ? '9+' : c.unreadCount}
                            </span>
                          )}
                        </div>
                      )}
                    </div>
                  );
                })}
              {contacts.filter(c => c.latestMsg !== undefined).length === 0 && (
                <div className="text-center py-12">
                  <div className="w-12 h-12 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-3">
                    <MessageSquare className="w-6 h-6 text-indigo-600" />
                  </div>
                  <p className="text-gray-400 text-xs sm:text-sm mb-3">No active chats.</p>
                  <button onClick={() => setSubTab('Contacts')} className="text-indigo-600 text-xs font-bold hover:underline uppercase tracking-wider">
                    Browse Contacts
                  </button>
                </div>
              )}
            </div>
          )}

          {!loading && subTab === 'Contacts' && (
            <div className="space-y-2.5">
              {contacts.map((c) => {
                const isSelected = c.friend_id === activeContactId;
                const isBlocked = blockedUsers.includes(c.friend_id);
                return (
                  <div
                    key={c.friend_id}
                    onClick={() => {
                      setActiveContactId(c.friend_id);
                      setSubTab('Chats');
                    }}
                    role="button"
                    tabIndex={0}
                    className={`w-full text-left p-3.5 rounded-xl transition-all flex items-center justify-between border cursor-pointer ${
                      isSelected 
                        ? 'bg-indigo-50 border-indigo-200 shadow-sm' 
                        : 'bg-white hover:bg-gray-50 border-gray-100'
                    } ${isBlocked ? 'opacity-75' : ''}`}
                  >
                    <div className="flex items-center space-x-3 min-w-0">
                      {c.profiles?.avatar_url ? (
                        <img 
                          src={c.profiles.avatar_url} 
                          alt={c.profiles.name} 
                          className={`w-10 h-10 rounded-full object-cover cursor-pointer hover:opacity-90 transition-opacity ${isBlocked ? 'grayscale-[0.5]' : ''}`}
                          referrerPolicy="no-referrer"
                          onClick={(e) => {
                            e.stopPropagation();
                            setFullScreenImage(c.profiles.avatar_url);
                          }}
                        />
                      ) : (
                        <div className={`w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm shrink-0 ${isBlocked ? 'bg-gray-200 text-gray-400' : getAvatarColorClass(c.profiles?.name || c.profiles?.name)}`}>
                          {getInitials(c.profiles?.name || c.profiles?.name)}
                        </div>
                      )}
                      <div className="min-w-0">
                        <div className="flex items-center space-x-1.5">
                          <p className={`font-bold text-xs sm:text-sm truncate ${isSelected ? 'text-indigo-900' : 'text-gray-900'}`}>
                            {c.profiles?.name || 'User'}
                          </p>
                          {isBlocked && (
                            <span className="bg-rose-100 text-rose-600 text-[8px] font-black uppercase px-1.5 py-0.5 rounded-full flex items-center gap-0.5 shadow-xs shrink-0">
                              <Ban className="w-2 h-2" />
                              Blocked
                            </span>
                          )}
                          {c.profiles?.status === 'Verified' && !isBlocked && (
                            <span className="inline-flex items-center shrink-0">
                              <ShieldCheck className="w-3.5 h-3.5 text-indigo-600 fill-green-50" />
                            </span>
                          )}
                        </div>
                        <p className="text-[11px] text-gray-400 truncate mt-0.5">
                          {c.profiles?.email || 'Active connection'}
                        </p>
                      </div>
                    </div>
                    
                    <div className="flex items-center space-x-1.5 shrink-0" onClick={(e) => e.stopPropagation()}>
                      <button
                        onClick={() => setShowProfileDetails(c.profiles)}
                        className="bg-gray-50 hover:bg-gray-100 text-indigo-600 font-bold text-[10px] px-2.5 py-1.5 rounded-lg transition-all active:scale-95 border border-gray-100"
                      >
                        View Profile
                      </button>
                      {unfriendConfirmId === c.friend_id ? (
                        <button
                          onClick={() => handleUnfriend(c.friend_id)}
                          onMouseLeave={() => setUnfriendConfirmId(null)}
                          className="bg-rose-600 hover:bg-rose-700 text-white font-bold text-[10px] px-2.5 py-1.5 rounded-lg transition-all active:scale-95 shadow-sm"
                        >
                          Confirm?
                        </button>
                      ) : (
                        <button
                          onClick={() => setUnfriendConfirmId(c.friend_id)}
                          title="Unfriend User"
                          className="p-1.5 bg-gray-50 hover:bg-rose-50 text-gray-400 hover:text-rose-600 rounded-lg transition-all border border-gray-100 hover:border-rose-100"
                        >
                          <UserMinus className="w-3.5 h-3.5" />
                        </button>
                      )}
                    </div>
                  </div>
                );
              })}
              {contacts.length === 0 && (
                <div className="text-center py-12">
                  <p className="text-gray-400 text-xs sm:text-sm mb-3">No contacts yet.</p>
                </div>
              )}
            </div>
          )}

          {!loading && subTab === 'Requests' && (
            <div className="space-y-6">
              {/* Incoming Requests */}
              <div className="space-y-3">
                <h3 className="text-xs font-black text-indigo-900 uppercase tracking-wider flex items-center gap-1.5 px-1">
                  <Bell className="w-3.5 h-3.5 text-indigo-600" />
                  Received Requests ({incomingRequests.length})
                </h3>
                {incomingRequests.length > 0 ? (
                  <div className="space-y-2.5">
                    {incomingRequests.map((req) => {
                      const sender = req.profiles || { name: 'User', email: 'Standard User' };
                      return (
                        <div key={req.id} className="flex items-center justify-between bg-white p-3.5 rounded-xl border border-gray-100 shadow-sm hover:border-indigo-100 transition-colors">
                          <div className="flex items-center space-x-3 min-w-0">
                            {sender.avatar_url ? (
                              <img 
                                src={sender.avatar_url} 
                                alt={sender.name} 
                                className="w-10 h-10 rounded-full object-cover cursor-pointer hover:opacity-90 transition-opacity"
                                referrerPolicy="no-referrer"
                                onClick={(e) => {
                                  e.stopPropagation();
                                  setFullScreenImage(sender.avatar_url);
                                }}
                              />
                            ) : (
                              <div className={`w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm shrink-0 ${getAvatarColorClass(sender.name)}`}>
                                {getInitials(sender.name)}
                              </div>
                            )}
                            <div className="min-w-0">
                              <p className="font-bold text-xs text-gray-900 truncate">{sender.name}</p>
                              <p className="text-[10px] text-gray-400 truncate">{sender.email}</p>
                            </div>
                          </div>
                          <div className="flex items-center space-x-1.5 shrink-0">
                            <button
                              onClick={() => handleAcceptRequest(req.id, req.sender_id)}
                              className="bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-[10px] px-3 py-1.5 rounded-lg transition-all active:scale-95 shadow-sm"
                            >
                              Accept
                            </button>
                            <button
                              onClick={() => handleDeclineRequest(req.id, req.sender_id)}
                              className="bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-[10px] px-3 py-1.5 rounded-lg transition-all active:scale-95"
                            >
                              Decline
                            </button>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                ) : (
                  <div className="text-center py-8 bg-white rounded-xl border border-dashed border-gray-200">
                    <p className="text-gray-400 text-[11px] font-medium uppercase tracking-wider">No pending requests</p>
                  </div>
                )}
              </div>

              {/* Sent Requests */}
              <div className="space-y-3">
                <h3 className="text-xs font-black text-gray-400 uppercase tracking-wider flex items-center gap-1.5 px-1">
                  <Send className="w-3.5 h-3.5" />
                  Sent Requests ({sentRequests.length})
                </h3>
                {sentRequests.length > 0 ? (
                  <div className="space-y-2.5">
                    {sentRequests.map((req) => {
                      // Note: fetchSentFriendRequests might not include profiles by default, 
                      // we'll need to check the logic or handle missing profiles
                      const receiver = req.profiles || { name: `User ${req.receiver_id?.substring(0,4) || '...'}` };
                      return (
                        <div key={req.id} className="flex items-center justify-between bg-gray-50/50 p-3 rounded-xl border border-gray-100">
                          <div className="flex items-center space-x-2.5 min-w-0 opacity-70">
                            <div className={`w-8 h-8 rounded-full flex items-center justify-center font-bold text-[10px] shrink-0 bg-gray-200 text-gray-500`}>
                              {getInitials(receiver.name)}
                            </div>
                            <div className="min-w-0">
                              <p className="font-bold text-xs text-gray-700 truncate">{receiver.name}</p>
                              <p className="text-[9px] text-gray-400 uppercase tracking-tighter">Waiting for response</p>
                            </div>
                          </div>
                          <button
                            onClick={() => handleCancelRequest(req.receiver_id)}
                            className="text-rose-600 hover:text-rose-700 font-black text-[9px] uppercase tracking-widest px-2 py-1 hover:bg-rose-50 rounded-md transition-all"
                          >
                            Cancel
                          </button>
                        </div>
                      );
                    })}
                  </div>
                ) : (
                  <div className="text-center py-8 bg-gray-50/50 rounded-xl border border-dashed border-gray-200">
                    <p className="text-gray-400 text-[11px] font-medium uppercase tracking-wider">No sent requests</p>
                  </div>
                )}
              </div>
            </div>
          )}

          {!loading && subTab === 'Discover' && (
            <div className="p-4 space-y-3">
              <div className="relative">
                <Search className="absolute left-3 top-1/2 -translate-y-1/2 text-indigo-600 w-4 h-4" />
                <input
                  type="text"
                  placeholder="Search users..."
                  value={search}
                  onChange={e => setSearch(e.target.value)}
                  className="w-full pl-9 pr-3 py-2 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
                />
              </div>
              {loadingProfiles ? (
                <div className="text-center py-10"><Loader2 className="animate-spin w-6 h-6 mx-auto text-indigo-600" /></div>
              ) : filteredProfiles.length > 0 ? (
                filteredProfiles.map(p => {
                  const status = getFriendshipStatus(p.id);
                  return (
                    <div 
                      key={p.id} 
                      className="p-3 bg-white border border-gray-100 rounded-xl shadow-sm text-sm flex items-center gap-3 cursor-pointer hover:border-indigo-200 transition-colors"
                      onClick={() => setShowProfileDetails({
                        id: p.id,
                        name: p.name,
                        email: p.email,
                        status: p.status,
                        avatar_url: p.avatar_url,
                        bio: p.bio,
                        username: p.username,
                        location: p.location,
                        title: p.title,
                        phone: p.phone,
                        website: p.website,
                        skills: p.skills
                      })}
                    >
                      {p.avatar_url ? (
                        <img 
                          src={p.avatar_url} 
                          alt={p.name || p.name} 
                          className="w-12 h-12 rounded-full object-cover shrink-0 cursor-pointer hover:opacity-90 transition-opacity" 
                          referrerPolicy="no-referrer" 
                          onClick={(e) => {
                            e.stopPropagation();
                            setFullScreenImage(p.avatar_url);
                          }}
                        />
                      ) : (
                        <div className={`w-12 h-12 rounded-full flex items-center justify-center font-bold text-sm shrink-0 ${getAvatarColorClass(p.name || p.name)}`}>
                          {getInitials(p.name || p.name)}
                        </div>
                      )}
                      <div className="min-w-0 flex-1">
                        <p className="font-bold text-gray-900 truncate">{p.name || p.name}</p>
                        <p className="text-[10px] text-gray-500 truncate">{p.email}</p>
                        <p className="text-[10px] text-gray-400 mt-0.5 line-clamp-1">
                          {p.bio ? p.bio : "No bio added yet."}
                        </p>
                      </div>
                      <div className="shrink-0" onClick={e => e.stopPropagation()}>
                        {status.type === 'friends' ? (
                          <button 
                            onClick={() => {
                              setActiveContactId(p.id);
                              setSubTab('Chats');
                            }}
                            className="bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold text-[10px] px-2.5 py-1.5 rounded-lg transition-all"
                          >
                            Message
                          </button>
                        ) : status.type === 'incoming' ? (
                          <div className="flex items-center space-x-1">
                            <button 
                              onClick={() => handleAcceptRequest(status.reqId!, p.id)}
                              className="bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-[10px] px-2 py-1.5 rounded-lg transition-all"
                            >
                              Accept
                            </button>
                            <button 
                              onClick={() => handleDeclineRequest(status.reqId!, p.id)}
                              className="bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold text-[10px] px-2 py-1.5 rounded-lg transition-all"
                            >
                              Decline
                            </button>
                          </div>
                        ) : status.type === 'outgoing' ? (
                          <button 
                            onClick={() => handleCancelRequest(p.id)}
                            className="bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 font-bold text-[10px] px-2.5 py-1.5 rounded-lg transition-all"
                          >
                            Cancel Request
                          </button>
                        ) : (
                          <button 
                            onClick={() => handleSendRequest(p.id)}
                            className="bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-[10px] px-3 py-1.5 rounded-lg transition-all shadow-sm active:scale-95"
                          >
                            Add Friend
                          </button>
                        )}
                      </div>
                    </div>
                  );
                })
              ) : (
                <p className="text-gray-500 text-sm text-center py-10">No users found.</p>
              )}
            </div>
          )}
        </div>
      </div>

      {/* 2. RIGHT SIDE: Main Live Chat Window */}
      <div className={`flex-1 w-full bg-white relative flex-col ${activeContactId ? 'flex' : 'hidden'}`}>
        {/* Chat Window Header */}
        <div className="h-16 border-b border-gray-200 flex items-center px-6 justify-between bg-white">
          {activeProfile ? (
            <>
              <div className="flex items-center space-x-3 min-w-0">
              <button 
                onClick={() => setActiveContactId(null)}
                className="p-1 rounded-full text-gray-500 hover:bg-gray-100"
              >
                <ArrowLeft className="w-5 h-5" />
              </button>
              <div 
                className="relative cursor-pointer group"
                onClick={() => setShowProfileDetails(activeProfile)}
              >
                {activeProfile.avatar_url ? (
                  <img 
                    src={activeProfile.avatar_url} 
                    alt={activeProfile.name} 
                    className="w-10 h-10 rounded-full object-cover shadow-sm group-hover:ring-2 group-hover:ring-indigo-500 transition-all cursor-pointer hover:opacity-90"
                    referrerPolicy="no-referrer"
                    onClick={(e) => {
                      e.stopPropagation();
                      setFullScreenImage(activeProfile.avatar_url);
                    }}
                  />
                ) : (
                  <div className={`w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm shrink-0 shadow-sm group-hover:ring-2 group-hover:ring-indigo-500 transition-all ${getAvatarColorClass(activeProfile.name)}`}>
                    {getInitials(activeProfile.name)}
                  </div>
                )}
                <div className="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-green-500 border-2 border-white rounded-full"></div>
              </div>
              <div 
                className="min-w-0 cursor-pointer"
                onClick={() => setShowProfileDetails(activeProfile)}
              >
                <div className="flex items-center space-x-1.5">
                  <h4 className="font-bold text-sm sm:text-base text-gray-900 truncate group-hover:text-indigo-600">
                    {activeProfile.name || 'Contact'}
                  </h4>
                  {activeContactId && blockedUsers.includes(activeContactId) && (
                    <span className="bg-rose-100 text-rose-600 text-[10px] font-black uppercase px-2 py-0.5 rounded-full flex items-center gap-1 shadow-xs shrink-0">
                      <Ban className="w-3 h-3" />
                      Blocked
                    </span>
                  )}
                </div>
              </div>
            </div>
            {/* Header Actions - Moved to corner */}
              <div className="absolute top-3 right-4 flex items-center gap-3">
                {isSelectionMode ? (
                   <>
                     <span className="text-xs font-bold text-gray-400 uppercase tracking-wider">{selectedMessageIds.size} selected</span>
                     <button 
                       onClick={handleDeleteSelected}
                       className="p-2 text-red-600 hover:bg-red-50 rounded-full transition-colors"
                       title="Delete Selected"
                       disabled={selectedMessageIds.size === 0}
                     >
                       <Trash2 className="w-5 h-5" />
                     </button>
                     <button 
                       onClick={() => { setIsSelectionMode(false); setSelectedMessageIds(new Set()); }}
                       className="text-xs font-black text-gray-500 hover:text-indigo-600 uppercase tracking-widest px-2"
                     >
                       Cancel
                     </button>
                   </>
                ) : (
                  <>
                    <button 
                      onClick={() => setHeaderMenuOpen(true)}
                      className="p-2 text-gray-400 hover:text-indigo-600 hover:bg-gray-100 rounded-full transition-all duration-200 shadow-xs hover:shadow-sm"
                      title="More Options"
                    >
                      <MoreVertical className="w-5 h-5" />
                    </button>

                    {/* Header Dropdown Menu */}
                    <AnimatePresence>
                      {headerMenuOpen && (
                        <>
                          <div 
                            className="fixed inset-0 z-[150]" 
                            onClick={() => setHeaderMenuOpen(false)} 
                          />
                          <motion.div
                            initial={{ opacity: 0, scale: 0.95, y: -10 }}
                            animate={{ opacity: 1, scale: 1, y: 0 }}
                            exit={{ opacity: 0, scale: 0.95, y: -10 }}
                            className="absolute right-6 top-14 w-48 bg-white border border-gray-100 rounded-2xl shadow-xl z-[160] overflow-hidden p-1.5"
                          >
                            <button
                              onClick={() => {
                                setIsSelectionMode(true);
                                setHeaderMenuOpen(false);
                              }}
                              className="w-full flex items-center gap-2.5 px-3 py-2.5 text-xs font-bold text-gray-600 hover:bg-gray-50 rounded-xl transition-colors"
                            >
                              <CheckSquare className="w-4 h-4 text-gray-400" />
                              Select Messages
                            </button>
                            <div className="h-px bg-gray-100 my-1 mx-2" />
                            {blockedUsers.includes(activeContactId) ? (
                              <button
                                onClick={() => {
                                  handleUnblockUser(activeContactId);
                                  setHeaderMenuOpen(false);
                                }}
                                className="w-full flex items-center gap-2.5 px-3 py-2.5 text-xs font-bold text-indigo-600 hover:bg-indigo-50 rounded-xl transition-colors"
                              >
                                <ShieldCheck className="w-4 h-4" />
                                Unblock User
                              </button>
                            ) : (
                              <button
                                onClick={() => {
                                  handleBlockUser(activeContactId);
                                  setHeaderMenuOpen(false);
                                }}
                                className="w-full flex items-center gap-2.5 px-3 py-2.5 text-xs font-bold text-rose-600 hover:bg-rose-50 rounded-xl transition-colors"
                              >
                                <Ban className="w-4 h-4" />
                                Block User
                              </button>
                            )}
                          </motion.div>
                        </>
                      )}
                    </AnimatePresence>
                  </>
                )}
              </div>
            </>
          ) : (
            <div className="text-sm text-gray-500 font-medium">Select a conversation</div>
          )}
        </div>

        {/* Conversation Messages */}
        <div 
          ref={containerRef}
          className="flex-1 overflow-y-auto px-4 sm:px-6 py-6 space-y-4 bg-gray-50/50"
        >
          {activeProfile ? (
            <>
              {activeMessages.map((msg, index) => {
                const isMe = msg.sender_id === userId;
                const isSystem = msg.content.startsWith('System:');
                
                // Date separator logic
                const currentDate = new Date(msg.created_at).toDateString();
                const prevDate = index > 0 ? new Date(activeMessages[index - 1].created_at).toDateString() : null;
                const showSeparator = currentDate !== prevDate;

                if (isSystem) {
                  return (
                    <React.Fragment key={msg.id}>
                      {showSeparator && (
                        <div className="flex justify-center w-full my-6 sticky top-2 z-10">
                          <span className="bg-gray-200/80 backdrop-blur-sm text-gray-600 text-[10px] font-bold py-1 px-3 rounded-full shadow-sm">
                            {formatDateSeparator(msg.created_at)}
                          </span>
                        </div>
                      )}
                      <div className="flex justify-center w-full my-2">
                        <div className="bg-indigo-50/80 border border-indigo-100/50 text-indigo-950 text-[11px] font-black py-1.5 px-4 rounded-full flex items-center gap-1.5 shadow-xs max-w-sm text-center">
                          <Bell className="w-3 h-3 text-indigo-600 shrink-0 animate-bounce" />
                          <span>{msg.content.replace(/^System:\s*/i, '')}</span>
                        </div>
                      </div>
                    </React.Fragment>
                  );
                }

                return (
                  <React.Fragment key={msg.id}>
                    {showSeparator && (
                      <div className="flex justify-center w-full my-6 sticky top-2 z-10">
                        <span className="bg-gray-200/80 backdrop-blur-sm text-gray-600 text-[10px] font-bold py-1 px-3 rounded-full shadow-sm border border-white/50">
                          {formatDateSeparator(msg.created_at)}
                        </span>
                      </div>
                    )}
                    <div className={`flex items-start gap-2.5 w-full relative ${isMe ? 'justify-end' : 'justify-start'}`}>
                    <div 
                      className="flex flex-col relative group"
                      onPointerDown={() => handlePointerDown(msg.id)}
                      onPointerUp={handlePointerUp}
                      onPointerLeave={handlePointerUp}
                      onContextMenu={(e) => { e.preventDefault(); }}
                      style={{ WebkitUserSelect: 'none', userSelect: 'none', WebkitTouchCallout: 'none' }}
                    >
                      {isSelectionMode && (
                        <div className="absolute top-1/2 -translate-y-1/2 -left-8 cursor-pointer" onClick={(e) => { e.stopPropagation(); handleToggleSelection(msg.id); }}>
                          {selectedMessageIds.has(msg.id) ? <CheckSquare className="w-5 h-5 text-indigo-600" /> : <Square className="w-5 h-5 text-gray-400" />}
                        </div>
                      )}

                      <div 
                        onDoubleClick={() => handleReactionSelect('👍', msg.id)}
                        className={`p-3 pb-5 text-xs sm:text-sm shadow-sm relative overflow-visible leading-relaxed ${isMe ? 'bg-indigo-600 text-white rounded-2xl rounded-tr-none' : 'bg-white text-gray-800 rounded-2xl rounded-tl-none border border-gray-100'} min-w-[60px] cursor-pointer active:scale-[0.98] transition-transform select-none`}
                      >
                        {editingMessageId === msg.id ? (
                          <div className="flex flex-col gap-2 min-w-[200px]">
                            <textarea
                              value={editingContent}
                              onChange={(e) => setEditingContent(e.target.value)}
                              className="bg-white/10 border border-white/20 text-white rounded-lg p-2 text-sm focus:outline-none focus:ring-1 focus:ring-white/50 resize-none min-h-[60px]"
                              autoFocus
                            />
                            <div className="flex justify-end gap-2">
                              <button 
                                onClick={(e) => { e.stopPropagation(); setEditingMessageId(null); }}
                                className="text-[10px] bg-white/10 hover:bg-white/20 px-2 py-1 rounded-md"
                              >
                                Cancel
                              </button>
                              <button 
                                onClick={(e) => { e.stopPropagation(); handleSaveEdit(); }}
                                className="text-[10px] bg-white text-indigo-600 hover:bg-gray-100 px-2 py-1 rounded-md font-bold"
                              >
                                Save
                              </button>
                            </div>
                          </div>
                        ) : (
                          <div className="whitespace-pre-wrap break-words">{msg.content}</div>
                        )}
                        
                        {/* Time and Read status */}
                        <div className={`absolute bottom-1 ${isMe ? 'right-2' : 'left-2'} flex items-center gap-1 opacity-60 text-[9px] font-medium ${isMe ? 'text-indigo-100' : 'text-gray-400'}`}>
                          <span>{formatTime(msg.created_at)}</span>
                        </div>

                        {/* 3-dot Menu Button - Moved to corner */}
                        <div className={`absolute top-0 ${isMe ? '-left-7' : '-right-7'} z-30 opacity-0 group-hover:opacity-100 transition-opacity pt-1`}>
                          <button 
                            onClick={(e) => { e.stopPropagation(); setMenuMessageId(msg.id); }}
                            className="w-6 h-6 rounded-full bg-white border border-gray-200 shadow-sm flex items-center justify-center text-gray-400 hover:text-indigo-600 hover:border-indigo-200 hover:bg-indigo-50 transition-all duration-200"
                            title="More options"
                          >
                            <MoreVertical className="w-3.5 h-3.5" />
                          </button>
                        </div>

                        {/* Render existing reactions and Add Reaction button - Offset from time */}
                        <div className={`absolute -bottom-4 ${isMe ? 'left-2' : 'right-2'} flex items-center gap-1.5 z-30`}>
                          {msg.reactions && Object.keys(msg.reactions).length > 0 ? (
                            <div 
                              onClick={(e) => { e.stopPropagation(); setReactionMessageId(msg.id); }}
                              className="bg-white border border-gray-200 rounded-full px-2 py-0.5 text-[12px] shadow-md flex items-center gap-1.5 hover:scale-110 transition-transform cursor-pointer ring-2 ring-white"
                            >
                              {Array.from(new Set(Object.values(msg.reactions))).map((emoji, i) => (
                                <motion.span 
                                  key={i}
                                  animate={{ 
                                    scale: [1, 1.15, 1],
                                  }}
                                  transition={{ 
                                    duration: 2.5, 
                                    repeat: Infinity, 
                                    ease: "easeInOut",
                                    delay: i * 0.4
                                  }}
                                  className="cursor-default"
                                >
                                  {emoji}
                                </motion.span>
                              ))}
                              {Object.keys(msg.reactions).length > 1 && (
                                <span className="text-gray-500 font-bold text-[10px] ml-0.5">
                                  {Object.keys(msg.reactions).length}
                                </span>
                              )}
                            </div>
                          ) : (
                            <button 
                              onClick={(e) => { e.stopPropagation(); setReactionMessageId(msg.id); }}
                              className="w-6 h-6 rounded-full bg-white border border-gray-200 shadow-sm flex items-center justify-center text-gray-400 hover:text-indigo-600 hover:border-indigo-200 hover:bg-indigo-50 transition-all duration-200 opacity-0 group-hover:opacity-100"
                              title="Add reaction"
                            >
                              <Smile className="w-3.5 h-3.5" />
                            </button>
                          )}
                        </div>
                      </div>

                      {/* Message Menu Overlay */}
                      {menuMessageId === msg.id && (
                        <div className="fixed top-0 left-0 w-full h-full flex items-center justify-center z-[100]">
                           <div className="fixed inset-0 bg-black/40 backdrop-blur-[2px] z-[90]" onClick={() => setMenuMessageId(null)} />
                           <div className="bg-white border border-gray-200 rounded-3xl shadow-2xl p-4 flex flex-col gap-2 z-[100] animate-in fade-in zoom-in duration-200 max-w-xs w-full mx-4">
                             <h3 className="text-xs font-bold text-gray-400 uppercase tracking-wider px-2 mb-1">Message Options</h3>
                             
                             <button 
                               onClick={(e) => { e.stopPropagation(); setIsSelectionMode(true); setMenuMessageId(null); handleToggleSelection(msg.id); }} 
                               className="text-gray-700 hover:bg-gray-100 px-4 py-2.5 rounded-xl text-sm font-medium flex items-center transition-colors"
                             >
                               <CheckSquare className="w-4 h-4 mr-3 text-gray-400" /> Select Message
                             </button>

                             {isMe && (
                               <button 
                                 onClick={(e) => { e.stopPropagation(); setMenuMessageId(null); startEditing(msg); }}
                                 className="text-indigo-600 hover:bg-indigo-50 px-4 py-2.5 rounded-xl text-sm font-medium flex items-center transition-colors"
                               >
                                 <Pencil className="w-4 h-4 mr-3" /> Edit Message
                               </button>
                             )}

                             <div className="h-px bg-gray-100 my-1" />

                             <button 
                               onClick={(e) => { e.stopPropagation(); setMenuMessageId(null); handleDeleteSingleMessage(msg.id); }} 
                               className="text-red-600 hover:bg-red-50 px-4 py-2.5 rounded-xl text-sm font-medium flex items-center transition-colors"
                             >
                               <Trash2 className="w-4 h-4 mr-3" /> Delete Message
                             </button>

                             <button 
                               onClick={(e) => { e.stopPropagation(); setMenuMessageId(null); }}
                               className="mt-2 text-gray-400 hover:text-gray-600 px-4 py-2 text-xs font-medium text-center"
                             >
                               Cancel
                             </button>
                           </div>
                        </div>
                      )}

                      {/* Reaction Picker Overlay */}
                      {reactionMessageId === msg.id && (
                        <div className="fixed top-0 left-0 w-full h-full flex items-center justify-center z-[100]">
                           <div className="fixed inset-0 bg-black/40 backdrop-blur-[2px] z-[90]" onClick={() => setReactionMessageId(null)} />
                           <div className="bg-white border border-gray-200 rounded-3xl shadow-2xl p-4 flex flex-col gap-4 z-[100] animate-in fade-in zoom-in duration-200 max-w-xs w-full mx-4">
                             <div className="flex flex-wrap justify-center gap-2">
                               {['👍', '❤️', '😂', '😮', '😢', '🔥'].map((emoji, i) => (
                                 <motion.button 
                                   key={emoji}
                                   whileHover={{ scale: 1.3, rotate: 10 }}
                                   whileTap={{ scale: 0.9 }}
                                   animate={{ 
                                     y: [0, -3, 0],
                                   }}
                                   transition={{ 
                                     y: {
                                       duration: 2,
                                       repeat: Infinity,
                                       delay: i * 0.1,
                                       ease: "easeInOut"
                                     }
                                   }}
                                   onClick={(e) => { e.stopPropagation(); handleReactionSelect(emoji); }}
                                   className="w-10 h-10 flex items-center justify-center text-2xl hover:bg-indigo-50 rounded-full transition-colors"
                                 >
                                   {emoji}
                                 </motion.button>
                               ))}
                               <button 
                                 onClick={(e) => { 
                                   e.stopPropagation(); 
                                   setShowEmojiPicker(true); 
                                 }}
                                 className="w-10 h-10 flex items-center justify-center text-gray-400 hover:text-indigo-600 hover:bg-gray-100 rounded-full transition-colors"
                               >
                                 <Plus className="w-6 h-6" />
                               </button>
                             </div>
                           </div>
                        </div>
                      )}
                    </div>
                  </div>
                </React.Fragment>
              );
            })}
              <div ref={messagesEndRef} />
            </>
          ) : (
             <div className="text-center py-12 text-gray-400">Select a contact</div>
          )}
        </div>

        {/* Message Input Box (Always Visible) */}
        <div className={`p-4 bg-white flex items-center justify-center shrink-0 ${!activeProfile ? 'opacity-50 pointer-events-none' : ''}`}>
          {activeContactId && blockedUsers.includes(activeContactId) ? (
            <div className="w-full max-w-2xl bg-gray-50 border border-gray-100 rounded-full flex items-center justify-center py-2.5 px-4 gap-3 shadow-sm">
              <Ban className="w-4 h-4 text-gray-400" />
              <span className="text-xs font-bold text-gray-500 uppercase tracking-wider">Contact Blocked</span>
              <button
                onClick={() => handleUnblockUser(activeContactId)}
                className="ml-2 text-indigo-600 hover:text-indigo-700 text-xs font-black uppercase tracking-widest hover:underline transition-all"
              >
                Unblock
              </button>
            </div>
          ) : (
            <div className="w-full max-w-2xl bg-gray-50/80 border border-gray-200/80 rounded-full flex items-center p-1.5 shadow-sm focus-within:ring-2 focus-within:ring-indigo-500/20 focus-within:bg-white transition-all">
              {/* Current User Avatar */}
              <div className="w-7 h-7 rounded-full overflow-hidden shrink-0 ml-1">
                {currentUserProfile?.avatar_url ? (
                  <img 
                    src={currentUserProfile.avatar_url} 
                    alt="Me" 
                    className="w-full h-full object-cover cursor-pointer hover:opacity-90 transition-opacity"
                    referrerPolicy="no-referrer"
                    onClick={(e) => {
                      e.stopPropagation();
                      setFullScreenImage(currentUserProfile.avatar_url);
                    }}
                  />
                ) : (
                  <div className={`w-full h-full flex items-center justify-center font-bold text-[9px] uppercase ${getAvatarColorClass(currentUserProfile?.name || 'Me')}`}>
                    {getInitials(currentUserProfile?.name || 'Me')}
                  </div>
                )}
              </div>

              <button 
                onClick={() => setShowEmojiPicker(!showEmojiPicker)}
                className="shrink-0 p-2 ml-1 text-gray-400 hover:text-indigo-600 hover:bg-gray-100 rounded-full transition-colors"
                title="Choose an Emoji"
              >
                <Smile className="w-4 h-4" />
              </button>
              
              <input
                type="text"
                value={messageText}
                onChange={(e) => setMessageText(e.target.value)}
                onKeyDown={(e) => {
                  if (e.key === 'Enter') {
                    handleSendMessage();
                  }
                }}
                placeholder="Message..."
                className="flex-1 py-1.5 px-2 bg-transparent text-sm text-gray-700 placeholder-gray-400 focus:outline-none min-w-0"
              />
              
              <button 
                onClick={() => handleSendMessage()}
                className={`p-2 rounded-full transition-all shrink-0 mr-0.5 ${messageText.trim() ? 'bg-indigo-600 text-white shadow-sm hover:bg-indigo-700 hover:scale-105' : 'bg-transparent text-gray-400'}`}
                disabled={!messageText.trim()}
              >
                <Send className="w-4 h-4" />
              </button>
            </div>
          )}
        </div>
        {/* Emoji Picker Popover */}
        <AnimatePresence>
          {showEmojiPicker && (
            <div className="fixed inset-0 z-[200] flex items-center justify-center">
              <div className="fixed inset-0 bg-black/40 backdrop-blur-[2px] z-[200]" onClick={() => { setShowEmojiPicker(false); setReactionMessageId(null); }} />
              <motion.div
                initial={{ opacity: 0, y: 15, scale: 0.95 }}
                animate={{ opacity: 1, y: 0, scale: 1 }}
                exit={{ opacity: 0, y: 15, scale: 0.95 }}
                className="relative z-[210] bg-white border border-gray-200 rounded-3xl shadow-2xl w-80 max-w-[90vw] flex flex-col overflow-hidden"
              >
              <div className="flex border-b border-gray-100 overflow-x-auto no-scrollbar bg-gray-50/80 p-1">
                {EMOJI_CATEGORIES.map(category => (
                  <button
                    key={category.name}
                    onClick={() => setActiveEmojiTab(category.name)}
                    className={`p-2 shrink-0 rounded-xl transition-colors ${activeEmojiTab === category.name ? 'bg-white shadow-sm text-indigo-600' : 'text-gray-500 hover:bg-gray-100'}`}
                    title={category.name}
                  >
                    {category.icon}
                  </button>
                ))}
              </div>
              <div className="p-3 max-h-64 overflow-y-auto no-scrollbar">
                {EMOJI_CATEGORIES.find(c => c.name === activeEmojiTab)?.emojis.map(emoji => (
                  <button 
                    key={emoji} 
                    onClick={() => handleSelectEmoji(emoji)} 
                    className="p-2 text-xl hover:bg-indigo-50 rounded-lg transition-colors inline-block"
                  >
                    {emoji}
                  </button>
                ))}
              </div>
              </motion.div>
            </div>
          )}
        </AnimatePresence>
      </div>

      {/* Profile Details Modal */}
      <AnimatePresence>
        {showProfileDetails && (
          <div className="fixed inset-0 z-[60] flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm">
            <motion.div
              initial={{ opacity: 0, scale: 0.9, y: 20 }}
              animate={{ opacity: 1, scale: 1, y: 0 }}
              exit={{ opacity: 0, scale: 0.9, y: 20 }}
              className="bg-white rounded-3xl shadow-2xl w-full max-w-md overflow-hidden relative"
            >
              <button 
                onClick={() => setShowProfileDetails(null)}
                className="absolute top-4 right-4 p-2 bg-gray-100 hover:bg-gray-200 text-gray-500 rounded-full transition-colors z-10"
              >
                <ArrowLeft className="w-5 h-5 rotate-180" />
              </button>

              <div className="h-32 bg-gradient-to-r from-indigo-500 to-purple-600 w-full relative">
                <div className="absolute -bottom-12 left-1/2 -translate-x-1/2">
                  {showProfileDetails.avatar_url ? (
                    <img 
                      src={showProfileDetails.avatar_url} 
                      alt={showProfileDetails.name || showProfileDetails.name} 
                      className="w-24 h-24 rounded-3xl object-cover border-4 border-white shadow-lg cursor-pointer hover:opacity-90 transition-opacity"
                      referrerPolicy="no-referrer"
                      onClick={(e) => {
                        e.stopPropagation();
                        setFullScreenImage(showProfileDetails.avatar_url);
                      }}
                    />
                  ) : (
                    <div className={`w-24 h-24 rounded-3xl flex items-center justify-center text-3xl font-bold border-4 border-white shadow-lg ${getAvatarColorClass(showProfileDetails.name || showProfileDetails.name)}`}>
                      {getInitials(showProfileDetails.name || showProfileDetails.name)}
                    </div>
                  )}
                </div>
              </div>

              <div className="pt-16 pb-8 px-8 text-center">
                <div className="flex items-center justify-center space-x-2 mb-1">
                  <h3 className="text-2xl font-black text-gray-900 tracking-tight">
                    {showProfileDetails.name || showProfileDetails.name}
                  </h3>
                  {showProfileDetails.status === 'Verified' && (
                    <ShieldCheck className="w-6 h-6 text-indigo-600" />
                  )}
                </div>
                {showProfileDetails.username && (
                  <p className="text-indigo-600 text-xs font-bold mb-1">
                    @{showProfileDetails.username}
                  </p>
                )}
                <p className="text-gray-500 text-sm font-medium mb-2">
                  {showProfileDetails.email}
                </p>

                {showProfileDetails.title && (
                  <p className="text-gray-900 text-sm font-bold mb-2">
                    {showProfileDetails.title}
                  </p>
                )}

                {(showProfileDetails.location || showProfileDetails.website || showProfileDetails.phone) && (
                  <div className="flex flex-wrap justify-center gap-4 mb-6">
                    {showProfileDetails.location && (
                      <div className="flex items-center text-xs text-gray-500 gap-1"><MapPin className="w-3.5 h-3.5"/> {showProfileDetails.location}</div>
                    )}
                    {showProfileDetails.phone && (
                      <div className="flex items-center text-xs text-gray-500 gap-1"><Phone className="w-3.5 h-3.5"/> {showProfileDetails.phone}</div>
                    )}
                    {showProfileDetails.website && (
                      <div className="flex items-center text-xs text-indigo-600 gap-1"><Globe className="w-3.5 h-3.5"/> <a href={showProfileDetails.website} target="_blank" rel="noopener noreferrer" className="hover:underline">{showProfileDetails.website.replace(/^https?:\/\//, '')}</a></div>
                    )}
                  </div>
                )}

                <div className="bg-gray-50 rounded-2xl p-6 text-left mb-6">
                  <h4 className="text-[10px] font-bold text-indigo-600 uppercase tracking-widest mb-2">About</h4>
                  <p className="text-gray-700 text-sm leading-relaxed">
                    {showProfileDetails.bio ? showProfileDetails.bio : "No bio added yet."}
                  </p>
                </div>

                {showProfileDetails.skills && showProfileDetails.skills.length > 0 && (
                  <div className="bg-white border border-gray-100 rounded-2xl p-6 text-left mb-6 shadow-sm">
                    <h4 className="text-[10px] font-bold text-indigo-600 uppercase tracking-widest mb-3">Skills</h4>
                    <div className="flex flex-wrap gap-2">
                      {showProfileDetails.skills.map((skill, idx) => (
                        <span key={idx} className="bg-gray-100 text-gray-700 text-[11px] px-3 py-1.5 rounded-lg font-medium">
                          {skill}
                        </span>
                      ))}
                    </div>
                  </div>
                )}

                <div className="grid grid-cols-2 gap-4 mb-6">
                  <div className="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm">
                    <p className="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Member Type</p>
                    <p className="text-sm font-bold text-gray-900">
                      {showProfileDetails.status === 'Verified' ? 'Professional' : 'Standard'}
                    </p>
                  </div>
                  <div className="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm">
                    <p className="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-1">Status</p>
                    <div className="flex items-center space-x-1.5 justify-center">
                      <div className="w-2 h-2 rounded-full bg-green-500"></div>
                      <p className="text-sm font-bold text-gray-900">Online</p>
                    </div>
                  </div>
                  <div className="bg-white border border-gray-100 rounded-2xl p-4 shadow-sm flex flex-col justify-center items-center col-span-2">
                    {blockedUsers.includes(showProfileDetails.id) ? (
                      <button 
                        onClick={() => handleUnblockUser(showProfileDetails.id)}
                        className="text-[10px] font-bold text-emerald-600 uppercase tracking-widest hover:underline"
                      >
                        Unblock User
                      </button>
                    ) : (
                      <button 
                        onClick={() => handleBlockUser(showProfileDetails.id)}
                        className="text-[10px] font-bold text-rose-600 uppercase tracking-widest hover:underline"
                      >
                        Block User
                      </button>
                    )}
                  </div>
                </div>

                {(() => {
                  const status = getFriendshipStatus(showProfileDetails.id);
                  return (
                    <div className="mt-8 space-y-3">
                      {status.type === 'friends' ? (
                        <div className="space-y-2.5">
                          <button 
                            onClick={() => {
                              setActiveContactId(showProfileDetails.id);
                              setSubTab('Chats');
                              setShowProfileDetails(null);
                            }}
                            className="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-black py-4 rounded-2xl transition-all shadow-lg shadow-indigo-200 active:scale-95 text-sm"
                          >
                            Send Message
                          </button>
                          {unfriendConfirmId === showProfileDetails.id ? (
                            <button 
                              onClick={() => handleUnfriend(showProfileDetails.id)}
                              onMouseLeave={() => setUnfriendConfirmId(null)}
                              className="w-full bg-rose-600 hover:bg-rose-700 text-white font-black py-3 rounded-2xl transition-all active:scale-95 text-xs sm:text-sm"
                            >
                              Are you sure? Click to Confirm
                            </button>
                          ) : (
                            <button 
                              onClick={() => setUnfriendConfirmId(showProfileDetails.id)}
                              className="w-full bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold py-3 rounded-2xl transition-all active:scale-95 text-xs sm:text-sm flex items-center justify-center gap-1.5"
                            >
                              <UserMinus className="w-4 h-4" />
                              <span>Unfriend User</span>
                            </button>
                          )}
                        </div>
                      ) : status.type === 'incoming' ? (
                        <div className="grid grid-cols-2 gap-3">
                          <button 
                            onClick={() => {
                              handleAcceptRequest(status.reqId!, showProfileDetails.id);
                            }}
                            className="bg-indigo-600 hover:bg-indigo-700 text-white font-black py-4 rounded-2xl transition-all shadow-lg shadow-indigo-200 active:scale-95 text-sm"
                          >
                            Accept Request
                          </button>
                          <button 
                            onClick={() => {
                              handleDeclineRequest(status.reqId!, showProfileDetails.id);
                            }}
                            className="bg-gray-100 hover:bg-gray-200 text-gray-700 font-black py-4 rounded-2xl transition-all active:scale-95 text-sm"
                          >
                            Decline
                          </button>
                        </div>
                      ) : status.type === 'outgoing' ? (
                        <button 
                          onClick={() => {
                            handleCancelRequest(showProfileDetails.id);
                          }}
                          className="w-full bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 font-black py-4 rounded-2xl transition-all active:scale-95 text-sm"
                        >
                          Cancel Request
                        </button>
                      ) : (
                        <button 
                          onClick={() => {
                            handleSendRequest(showProfileDetails.id);
                          }}
                          className="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-black py-4 rounded-2xl transition-all shadow-lg shadow-indigo-200 active:scale-95"
                        >
                          Add Friend
                        </button>
                      )}
                      <button 
                        onClick={() => setShowProfileDetails(null)}
                        className="w-full bg-gray-50 hover:bg-gray-100 text-gray-500 font-bold py-3 rounded-2xl transition-all active:scale-95 text-xs sm:text-sm"
                      >
                        Back to Chat
                      </button>
                    </div>
                  );
                })()}
              </div>
            </motion.div>
          </div>
        )}
      </AnimatePresence>

      {/* Toast Alert Notification */}
      <AnimatePresence>
        {toast && (
          <motion.div
            initial={{ opacity: 0, y: -40, scale: 0.95 }}
            animate={{ opacity: 1, y: 0, scale: 1 }}
            exit={{ opacity: 0, y: -20, scale: 0.95 }}
            className="absolute top-6 left-1/2 -translate-x-1/2 z-50 bg-white border border-indigo-100 shadow-2xl rounded-2xl px-4 py-3.5 flex items-center gap-3 max-w-sm w-full mx-4"
          >
            <div className={`w-8 h-8 rounded-full flex items-center justify-center shrink-0 ${
              toast.type === 'success' 
                ? 'bg-green-50 text-green-500' 
                : toast.type === 'error' 
                  ? 'bg-red-50 text-red-500' 
                  : 'bg-indigo-50 text-indigo-500'
            }`}>
              {toast.type === 'success' ? (
                <Check className="w-4 h-4" />
              ) : toast.type === 'error' ? (
                <X className="w-4 h-4" />
              ) : (
                <Bell className="w-4 h-4" />
              )}
            </div>
            <div className="flex-1 min-w-0">
              <p className="text-xs font-black text-gray-900 leading-tight">System Message</p>
              <p className="text-[11px] text-gray-500 mt-0.5 leading-normal font-semibold">{toast.message}</p>
            </div>
            <button 
              onClick={() => setToast(null)}
              className="p-1 rounded-full text-gray-400 hover:bg-gray-50 transition-colors"
            >
              <X className="w-3.5 h-3.5" />
            </button>
          </motion.div>
        )}
      </AnimatePresence>
      </motion.div>
    </div>
  );
}
