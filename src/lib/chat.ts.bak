import { supabase } from './supabase';

export interface Profile {
  id: string;
  name: string;
  email: string;
  status: string;
  avatar_url?: string;
  bio?: string;
  username?: string;
  location?: string;
  title?: string;
  phone?: string;
  website?: string;
  skills?: string[];
  cleared_all_at?: string;
}

let friendshipsSchemaVersion: 'v1' | 'v2' | 'v3' | null = null;
let useLocalFallback = false;

const isUUID = (id: string) => /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(id);

// Function to reset fallback state (can be called to retry Supabase)
export const resetChatFallback = () => {
  useLocalFallback = false;
  friendshipsSchemaVersion = null;
};

// Local storage helpers
function getLocalFriendships(): any[] {
  try {
    const data = localStorage.getItem('chat_friendships');
    return data ? JSON.parse(data) : [];
  } catch (e) {
    console.warn('Error reading local friendships:', e);
    return [];
  }
}

function saveLocalFriendships(friendships: any[]) {
  try {
    localStorage.setItem('chat_friendships', JSON.stringify(friendships));
  } catch (e) {
    console.warn('Error saving local friendships:', e);
  }
}

function getLocalFriendRequests(): any[] {
  try {
    const data = localStorage.getItem('chat_friend_requests');
    return data ? JSON.parse(data) : [];
  } catch (e) {
    console.warn('Error reading local friend requests:', e);
    return [];
  }
}

function saveLocalFriendRequests(requests: any[]) {
  try {
    localStorage.setItem('chat_friend_requests', JSON.stringify(requests));
  } catch (e) {
    console.warn('Error saving local friend requests:', e);
  }
}

async function getFriendshipsSchemaVersion(): Promise<'v1' | 'v2' | 'v3'> {
  if (friendshipsSchemaVersion) return friendshipsSchemaVersion;
  
  try {
    // Try v3 first (user_id1, user_id2)
    const { error: errorV3 } = await supabase
      .from('friendships')
      .select('user_id1, user_id2')
      .limit(1);
    
    if (!errorV3) {
      friendshipsSchemaVersion = 'v3';
      return 'v3';
    }

    // Try v2 (sender_id, receiver_id)
    const { error: errorV2 } = await supabase
      .from('friendships')
      .select('sender_id, receiver_id')
      .limit(1);
      
    if (!errorV2) {
      friendshipsSchemaVersion = 'v2';
      return 'v2';
    }

    // Default to v1 (user_id, friend_id)
    friendshipsSchemaVersion = 'v1';
  } catch (e: any) {
    friendshipsSchemaVersion = 'v1';
  }
  return friendshipsSchemaVersion || 'v1';
}

const getLocalContacts = async (userId: string) => {
  const localFriendships = getLocalFriendships();
  const friendships = localFriendships.filter((f: any) => f.sender_id === userId || f.receiver_id === userId);
  const friendIds = new Set(friendships.map((f: any) => f.sender_id === userId ? f.receiver_id : f.sender_id));

  // Also scan messages to find anyone else we've talked to
  try {
    const data = localStorage.getItem('chat_messages');
    if (data) {
      const allMessages: Message[] = JSON.parse(data);
      allMessages.forEach(m => {
        if (m.sender_id === userId) friendIds.add(m.receiver_id);
        if (m.receiver_id === userId) friendIds.add(m.sender_id);
      });
    }
  } catch (e) {
    console.warn('Error scanning messages for contacts:', e);
  }

  const validFriendIds = Array.from(friendIds).filter((id): id is string => typeof id === 'string' && id.trim() !== '');
  if (validFriendIds.length === 0) return [];

  let profiles: any[] = [];
  try {
    const { data } = await supabase
      .from('profiles')
      .select('*')
      .in('id', validFriendIds);
    if (data) profiles = data;
  } catch (err: any) {
    console.warn('Error pre-fetching profiles for local contacts:', err?.message || err);
  }

  const profileMap = new Map(profiles.map(p => [p.id, p]));

  return validFriendIds.map((friendId) => {
    let profile = profileMap.get(friendId);
    if (!profile) {
      profile = {
        id: friendId,
        name: `User ${friendId.substring(0, 4)}`,
        email: `${friendId.substring(0, 4)}@example.com`,
        status: 'Active'
      };
    }
    return {
      friend_id: friendId,
      profiles: profile
    };
  });
};

const getLocalFriendRequestsData = async (userId: string) => {
  const localRequests = getLocalFriendRequests();
  const requests = localRequests.filter((r: any) => r.receiver_id === userId);
  const senderIds = requests.map((r: any) => r.sender_id);

  const validSenderIds = senderIds.filter((id): id is string => typeof id === 'string' && id.trim() !== '');
  if (validSenderIds.length === 0) return [];

  let profiles: any[] = [];
  try {
    const { data } = await supabase
      .from('profiles')
      .select('*')
      .in('id', validSenderIds);
    if (data) profiles = data;
  } catch (err: any) {
    console.error('Detailed Error pre-fetching profiles for local friend requests:', {
      message: err?.message || 'Unknown error',
      code: err?.code || 'N/A',
      details: err?.details || '',
      hint: err?.hint || '',
      fullError: err
    });
  }

  const profileMap = new Map(profiles.map(p => [p.id, p]));

  return requests.map((r: any) => {
    let profile = profileMap.get(r.sender_id);
    if (!profile) {
      profile = {
        id: r.sender_id,
        name: `User ${r.sender_id.substring(0, 4)}`,
        email: `${r.sender_id.substring(0, 4)}@example.com`,
        status: 'Active'
      };
    }
    return {
      id: r.id,
      sender_id: r.sender_id,
      profiles: profile
    };
  });
};

const getLocalAllUsers = async (userId: string) => {
  let profiles: any[] = [];
  try {
    let data: any[] | null = null;
    let error: any = null;
    
    const firstResult = await supabase.from('profiles').select('*');
    data = firstResult.data;
    error = firstResult.error;
    if (data) profiles = data;
  } catch (err: any) {
    console.error('Detailed Error pre-fetching all profiles:', {
      message: err?.message || 'Unknown error',
      code: err?.code || 'N/A',
      details: err?.details || '',
      hint: err?.hint || '',
      fullError: err
    });
  }

  let topups: any[] = [];
  try {
    const { data } = await supabase.from('topups').select('user_id, amount, status');
    if (data) topups = data;
  } catch (err: any) {
    console.error('Detailed Error pre-fetching topups for verification status:', {
      message: err?.message || 'Unknown error',
      code: err?.code || 'N/A',
      details: err?.details || '',
      hint: err?.hint || '',
      fullError: err
    });
  }

  const userSums: Record<string, number> = {};
  topups.forEach((t: any) => {
    if (t.status === 'Approved' || !t.status) {
      userSums[t.user_id] = (userSums[t.user_id] || 0) + Number(t.amount);
    }
  });

  const localFriendships = getLocalFriendships();
  const friendIds = localFriendships
    .filter((f: any) => f.sender_id === userId || f.receiver_id === userId)
    .map((f: any) => f.sender_id === userId ? f.receiver_id : f.sender_id);

  const localRequests = getLocalFriendRequests();
  const sentRequestIds = localRequests
    .filter((r: any) => r.sender_id === userId)
    .map((r: any) => r.receiver_id);
  const receivedRequestIds = localRequests
    .filter((r: any) => r.receiver_id === userId)
    .map((r: any) => r.sender_id);

  const excludedIds = new Set([userId, ...friendIds, ...sentRequestIds, ...receivedRequestIds]);
  return profiles
    .filter(p => !excludedIds.has(p.id))
    .map((p: any) => {
      const totalTopups = userSums[p.id] || 0;
      const isVerified = totalTopups >= 20 || p.status === 'Verified';
      return {
        ...p,
        status: isVerified ? 'Verified' : 'Active',
        totalTopups
      };
    })
    .filter((p: any) => p.status === 'Verified');
};

export const fetchContacts = async (userId: string) => {
  try {
    if (!isUUID(userId)) return getLocalContacts(userId);
    
    const version = await getFriendshipsSchemaVersion();
    
    let friendships: any[] | null = null;
    let friendshipError: any = null;
    
    if (version === 'v3') {
      const { data, error } = await supabase
        .from('friendships')
        .select('user_id1, user_id2')
        .or(`user_id1.eq.${userId},user_id2.eq.${userId}`);
      friendships = data;
      friendshipError = error;
    } else if (version === 'v2') {
      const { data, error } = await supabase
        .from('friendships')
        .select('sender_id, receiver_id')
        .or(`sender_id.eq.${userId},receiver_id.eq.${userId}`);
      friendships = data;
      friendshipError = error;
    } else {
      const { data, error } = await supabase
        .from('friendships')
        .select('user_id, friend_id')
        .or(`user_id.eq.${userId},friend_id.eq.${userId}`);
      friendships = data;
      friendshipError = error;
    }
    
    if (friendshipError) {
      // If table is missing, use local fallback quietly
      if (friendshipError.code === '42P01' || friendshipError.message?.includes('relation') || friendshipError.message?.includes('does not exist')) {
        return getLocalContacts(userId);
      }
      throw friendshipError;
    }
    
    if (!friendships || friendships.length === 0) {
      // If DB is empty, also return local contacts to ensure we show something
      const local = await getLocalContacts(userId);
      return local;
    }

    const friendIds = friendships.map(f => {
      if (version === 'v3') {
        return f.user_id1 === userId ? f.user_id2 : f.user_id1;
      } else if (version === 'v2') {
        return f.sender_id === userId ? f.receiver_id : f.sender_id;
      } else {
        return f.user_id === userId ? f.friend_id : (f.user_id || f.friend_id);
      }
    });
    
    const validFriendIds = friendIds.filter((id): id is string => typeof id === 'string' && id.trim() !== '');
    const supabaseFriendIds = validFriendIds.filter(isUUID);
    
    // Fetch profiles for these friends
    let profiles: any[] | null = null;
    let profilesError: any = null;

    if (supabaseFriendIds.length > 0) {
      const result = await supabase
        .from('profiles')
        .select('*')
        .in('id', supabaseFriendIds);
      
      profiles = result.data;
      profilesError = result.error;
    } else {
      profiles = [];
      profilesError = null;
    }

    if (profilesError) {
      console.warn('Error fetching profiles for contacts, using local info:', profilesError);
    }

    const profileMap = new Map((profiles || []).map(p => [p.id, p]));

    // EXCLUDE BLOCKED USERS
    const blockedUsers = await fetchBlockedUsers(userId);
    const nonBlockedFriendIds = validFriendIds.filter(id => !blockedUsers.includes(id));

    // Fetch unread message counts for each contact
    let unreadCountsMap: Record<string, number> = {};
    if (nonBlockedFriendIds.length > 0) {
      const supabaseIds = nonBlockedFriendIds.filter(isUUID);
      if (supabaseIds.length > 0) {
        const { data: unreadData } = await supabase
          .from('messages')
          .select('sender_id')
          .eq('receiver_id', userId)
          .eq('is_read', false)
          .in('sender_id', supabaseIds);
        
        if (unreadData) {
          unreadData.forEach(m => {
            unreadCountsMap[m.sender_id] = (unreadCountsMap[m.sender_id] || 0) + 1;
          });
        }
      }
    }

    // Also get local contacts to merge (to ensure previously made chats display)
    const localContacts = await getLocalContacts(userId);
    
    // Create the final result list based on non-blocked IDs
    const result = nonBlockedFriendIds.map((friendId) => {
      let profile = profileMap.get(friendId);
      
      // If profile not in DB, check local contacts
      if (!profile) {
        const local = localContacts.find(lc => lc.friend_id === friendId);
        if (local) profile = local.profiles;
      }

      return {
        friend_id: friendId,
        profiles: profile || {
          id: friendId,
          name: `User ${friendId.substring(0, 4)}`,
          status: 'Active'
        },
        unreadCount: unreadCountsMap[friendId] || 0
      };
    });

    // Merge in any local contacts that aren't in the DB friendships yet and ARE NOT BLOCKED
    localContacts.forEach(lc => {
      if (!blockedUsers.includes(lc.friend_id) && !result.some(r => r.friend_id === lc.friend_id)) {
        result.push({
          ...lc,
          unreadCount: 0
        });
      }
    });

    return result;
  } catch (e: any) {
    console.warn('Error fetching contacts from DB, falling back to local:', e?.message || e);
    return getLocalContacts(userId);
  }
};

export const fetchFriendRequests = async (userId: string) => {
  try {
    if (!isUUID(userId)) return getLocalFriendRequestsData(userId);
    await getFriendshipsSchemaVersion();
    if (useLocalFallback) {
      return getLocalFriendRequestsData(userId);
    }

    const { data: requests, error: requestsError } = await supabase
      .from('friend_requests')
      .select('id, sender_id')
      .eq('receiver_id', userId);
    
    if (requestsError) {
      if (requestsError.code === '42P01' || requestsError.message?.includes('relation') || requestsError.message?.includes('does not exist')) {
        useLocalFallback = true;
        return getLocalFriendRequestsData(userId);
      }
      throw requestsError;
    }
    if (!requests || requests.length === 0) return [];

    const senderIds = requests.map(r => r.sender_id);
    const validSenderIds = senderIds.filter((id): id is string => typeof id === 'string' && id.trim() !== '');
    const supabaseSenderIds = validSenderIds.filter(isUUID);

    const { data: profiles, error: profilesError } = supabaseSenderIds.length > 0
      ? await supabase
        .from('profiles')
        .select('*')
        .in('id', supabaseSenderIds)
      : { data: [], error: null };

    if (profilesError) throw profilesError;

    const profileMap = new Map((profiles || []).map(p => [p.id, p] as [string, any]));

    return requests.map(r => ({
      id: r.id,
      sender_id: r.sender_id,
      profiles: profileMap.get(r.sender_id) || null
    }));
  } catch (e: any) {
    if (e?.code === '42P01' || e?.message?.includes('does not exist')) {
      return getLocalFriendRequestsData(userId);
    }
    console.warn('Error fetching friend requests from DB, falling back to local:', e?.message || e);
    useLocalFallback = true;
    return getLocalFriendRequestsData(userId);
  }
};

export interface Message {
  id: string;
  sender_id: string;
  receiver_id: string;
  content: string;
  created_at: string;
  reactions?: Record<string, string>;
  is_read?: boolean;
}

const getDeletedMessageIds = (): string[] => {
  try {
    const data = localStorage.getItem('deleted_message_ids');
    return data ? JSON.parse(data) : [];
  } catch {
    return [];
  }
};

const markAsDeletedLocally = (ids: string[]) => {
  const current = getDeletedMessageIds();
  const updated = Array.from(new Set([...current, ...ids]));
  localStorage.setItem('deleted_message_ids', JSON.stringify(updated));
};

export const getLocalMessages = async (userId1: string, userId2: string): Promise<Message[]> => {
  const deletedIds = getDeletedMessageIds();
  const clearedAllAt1 = localStorage.getItem(`cleared_all_at_${userId1}`);
  const clearedAllAt2 = localStorage.getItem(`cleared_all_at_${userId2}`);
  
  const isDeleted = (m: Message) => {
    if (deletedIds.includes(m.id)) return true;
    const msgTime = new Date(m.created_at).getTime();
    if (clearedAllAt1 && (m.sender_id === userId1 || m.receiver_id === userId1)) {
      if (msgTime <= new Date(clearedAllAt1).getTime()) return true;
    }
    if (clearedAllAt2 && (m.sender_id === userId2 || m.receiver_id === userId2)) {
      if (msgTime <= new Date(clearedAllAt2).getTime()) return true;
    }
    return false;
  };
  
  if (!isUUID(userId1) || !isUUID(userId2)) {
    // Fallback to local if IDs are not valid UUIDs
    const localData = localStorage.getItem('chat_messages');
    if (!localData) return [];
    try {
      const allMessages: Message[] = JSON.parse(localData);
      return allMessages
        .filter(
          (m) =>
            ((m.sender_id === userId1 && m.receiver_id === userId2) ||
             (m.sender_id === userId2 && m.receiver_id === userId1)) &&
            !isDeleted(m)
        )
        .sort((a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime());
    } catch {
      return [];
    }
  }

  try {
    // Attempt database fetch with a timeout
    const fetchPromise = supabase
      .from('messages')
      .select('*')
      .or(`and(sender_id.eq.${userId1},receiver_id.eq.${userId2}),and(sender_id.eq.${userId2},receiver_id.eq.${userId1})`)
      .order('created_at', { ascending: true });

    const { data, error } = await Promise.race([
      fetchPromise,
      new Promise<{ data: any; error: any }>((_, reject) =>
        setTimeout(() => reject(new Error('Fetch timeout')), 5000)
      )
    ]);
    
    if (error) throw error;
    const messages: Message[] = data || [];
    return messages.filter(m => !isDeleted(m));
  } catch (e: any) {
    if (e?.code === '42P01' || e?.message?.includes('does not exist') || e?.code === 'PGRST116') {
      useLocalFallback = true;
    }
    console.warn('Error fetching messages from DB, falling back to local:', e?.message || e);
    // Fallback to local
    const localData = localStorage.getItem('chat_messages');
    if (!localData) return [];
    try {
      const allMessages: Message[] = JSON.parse(localData);
      return allMessages
        .filter(
          (m) =>
            ((m.sender_id === userId1 && m.receiver_id === userId2) ||
             (m.sender_id === userId2 && m.receiver_id === userId1)) &&
            !isDeleted(m)
        )
        .sort((a, b) => new Date(a.created_at).getTime() - new Date(b.created_at).getTime());
    } catch {
      return [];
    }
  }
};

export const sendLocalMessage = async (senderId: string, receiverId: string, content: string): Promise<Message> => {
  const newMessage = {
    sender_id: senderId,
    receiver_id: receiverId,
    content,
    created_at: new Date().toISOString(),
    is_read: false
  };

  try {
    const { data, error } = await supabase
      .from('messages')
      .insert([newMessage])
      .select()
      .single();
    
    if (error) {
      if (error.code === '42P01' || error.message?.includes('does not exist')) {
        // Fallback to local
        const localData = localStorage.getItem('chat_messages');
        const allMessages: Message[] = localData ? JSON.parse(localData) : [];
        const msg = { ...newMessage, id: Math.random().toString(36).substring(2, 15) };
        allMessages.push(msg);
        localStorage.setItem('chat_messages', JSON.stringify(allMessages));
        return msg;
      }
      throw error;
    }
    return data;
  } catch (e: any) {
    console.error('Error sending message to DB:', e);
    // Absolute fallback
    return { ...newMessage, id: 'temp-' + Date.now() };
  }
};

export const ensureFriendship = async (userId: string, friendId: string) => {
  // 1. Ensure in local friendships
  const localFriendships = getLocalFriendships();
  const alreadyFriends = localFriendships.some((f: any) => 
    (f.sender_id === userId && f.receiver_id === friendId) || 
    (f.sender_id === friendId && f.receiver_id === userId)
  );
  if (!alreadyFriends) {
    localFriendships.push({
      id: Math.random().toString(36).substring(2, 15),
      sender_id: userId,
      receiver_id: friendId,
      created_at: new Date().toISOString()
    });
    saveLocalFriendships(localFriendships);
  }

  // 2. Try DB if available
  try {
    const version = await getFriendshipsSchemaVersion();
    if (useLocalFallback) return;

    let query;
    if (version === 'v3') {
      query = supabase
        .from('friendships')
        .select('id')
        .or(`and(user_id1.eq.${userId},user_id2.eq.${friendId}),and(user_id1.eq.${friendId},user_id2.eq.${userId})`);
    } else if (version === 'v2') {
      query = supabase
        .from('friendships')
        .select('id')
        .or(`and(sender_id.eq.${userId},receiver_id.eq.${friendId}),and(sender_id.eq.${friendId},receiver_id.eq.${userId})`);
    } else {
      query = supabase
        .from('friendships')
        .select('id')
        .or(`and(user_id.eq.${userId},friend_id.eq.${friendId}),and(user_id.eq.${friendId},friend_id.eq.${userId})`);
    }
    const { data: existing } = await query;
    if (!existing || existing.length === 0) {
      let insertData: any = {};
      if (version === 'v3') {
        insertData = { user_id1: userId, user_id2: friendId };
      } else if (version === 'v2') {
        insertData = { sender_id: userId, receiver_id: friendId, status: 'accepted' };
      } else {
        insertData = { user_id: userId, friend_id: friendId, status: 'accepted' };
      }
      await supabase.from('friendships').insert(insertData);
    }
  } catch (e: any) {
    console.error('Detailed Error ensuring friendship sync:', {
      message: e?.message || 'Unknown error',
      code: e?.code || 'N/A',
      details: e?.details || '',
      hint: e?.hint || '',
      fullError: e
    });
  }
};

export const sendFriendRequest = async (senderId: string, receiverId: string) => {
  // Save local copy
  const localRequests = getLocalFriendRequests();
  const alreadyExists = localRequests.some(
    (r: any) => r.sender_id === senderId && r.receiver_id === receiverId
  );
  if (!alreadyExists) {
    localRequests.push({
      id: Math.random().toString(36).substring(2, 15),
      sender_id: senderId,
      receiver_id: receiverId,
      status: 'pending',
      created_at: new Date().toISOString()
    });
    saveLocalFriendRequests(localRequests);
  }

  // Try DB
  try {
    if (!isUUID(senderId) || !isUUID(receiverId)) return;
    
    // Check if request already exists in DB to avoid unique constraint violations
    const { data: existing } = await supabase
      .from('friend_requests')
      .select('id')
      .eq('sender_id', senderId)
      .eq('receiver_id', receiverId);
      
    if (!existing || existing.length === 0) {
      await supabase.from('friend_requests').insert({
        sender_id: senderId,
        receiver_id: receiverId,
        status: 'pending'
      });
    }
  } catch (e) {
    console.warn('Error sending friend request to DB, using local:', e);
  }
};

export const acceptFriendRequest = async (userId: string, requestId: string, senderId: string) => {
  // 1. Remove from local friend requests
  const localRequests = getLocalFriendRequests();
  const filteredRequests = localRequests.filter((r: any) => r.id !== requestId && !(r.sender_id === senderId && r.receiver_id === userId));
  saveLocalFriendRequests(filteredRequests);

  // 2. Ensure friendship (creates the friendship row)
  await ensureFriendship(userId, senderId);

  // 3. Delete from DB friend_requests if possible
  try {
    if (!isUUID(requestId) && !isUUID(senderId)) return;
    
    if (isUUID(requestId)) {
      await supabase.from('friend_requests').delete().eq('id', requestId);
    } else {
      await supabase.from('friend_requests').delete().eq('sender_id', senderId).eq('receiver_id', userId);
    }
  } catch (e) {
    console.warn('Error deleting friend request from DB:', e);
  }
};

export const rejectFriendRequest = async (userId: string, requestId: string, senderId: string) => {
  // 1. Remove from local friend requests
  const localRequests = getLocalFriendRequests();
  const filteredRequests = localRequests.filter((r: any) => r.id !== requestId && !(r.sender_id === senderId && r.receiver_id === userId));
  saveLocalFriendRequests(filteredRequests);

  // 2. Delete from DB friend_requests
  try {
    if (!isUUID(requestId) && !isUUID(senderId)) return;
    if (isUUID(requestId)) {
      await supabase.from('friend_requests').delete().eq('id', requestId);
    } else {
      await supabase.from('friend_requests').delete().eq('sender_id', senderId).eq('receiver_id', userId);
    }
  } catch (e) {
    console.warn('Error deleting friend request from DB:', e);
  }
};

export const cancelFriendRequest = async (senderId: string, receiverId: string) => {
  // 1. Remove from local friend requests
  const localRequests = getLocalFriendRequests();
  const filteredRequests = localRequests.filter((r: any) => !(r.sender_id === senderId && r.receiver_id === receiverId));
  saveLocalFriendRequests(filteredRequests);

  // 2. Delete from DB friend_requests
  try {
    if (!isUUID(senderId) || !isUUID(receiverId)) return;
    await supabase.from('friend_requests').delete().eq('sender_id', senderId).eq('receiver_id', receiverId);
  } catch (e) {
    console.warn('Error cancelling friend request in DB:', e);
  }
};

export const fetchSentFriendRequests = async (userId: string) => {
  try {
    if (!isUUID(userId)) {
      const localRequests = getLocalFriendRequests();
      const sent = localRequests.filter((r: any) => r.sender_id === userId);
      const receiverIds = sent.map((r: any) => r.receiver_id);
      
      const { data: profiles } = await supabase
        .from('profiles')
        .select('*')
        .in('id', receiverIds.filter((id): id is string => typeof id === 'string'));
        
      const profileMap = new Map((profiles || []).map(p => [p.id, p]));
      
      return sent.map(r => ({
        ...r,
        profiles: profileMap.get(r.receiver_id) || null
      }));
    }
    
    const { data: requests, error } = await supabase
      .from('friend_requests')
      .select('*')
      .eq('sender_id', userId);
      
    if (error) {
      if (error.code === '42P01' || error.message?.includes('relation') || error.message?.includes('does not exist')) {
        return fetchSentFriendRequests(userId); // Retry with local logic which is already handled above
      }
      throw error;
    }
    
    if (!requests || requests.length === 0) return [];
    
    const receiverIds = requests.map(r => r.receiver_id);
    const { data: profiles, error: profileError } = await supabase
      .from('profiles')
      .select('*')
      .in('id', receiverIds);
      
    if (profileError) throw profileError;
    
    const profileMap = new Map((profiles || []).map(p => [p.id, p]));
    
    return requests.map(r => ({
      ...r,
      profiles: profileMap.get(r.receiver_id) || null
    }));
  } catch (e) {
    console.warn('Error fetching sent friend requests:', e);
    const localRequests = getLocalFriendRequests();
    return localRequests.filter((r: any) => r.sender_id === userId);
  }
};

export const unfriend = async (userId: string, friendId: string) => {
  // 1. Remove from local friendships
  const localFriendships = getLocalFriendships();
  const filteredFriendships = localFriendships.filter((f: any) => 
    !((f.sender_id === userId && f.receiver_id === friendId) || 
      (f.sender_id === friendId && f.receiver_id === userId))
  );
  saveLocalFriendships(filteredFriendships);

  // 2. Delete from DB friendships if available
  try {
    if (!isUUID(userId) || !isUUID(friendId)) return;
    const version = await getFriendshipsSchemaVersion();
    if (useLocalFallback) return;

    if (version === 'v3') {
      await supabase
        .from('friendships')
        .delete()
        .or(`and(user_id1.eq.${userId},user_id2.eq.${friendId}),and(user_id1.eq.${friendId},user_id2.eq.${userId})`);
    } else if (version === 'v2') {
      await supabase
        .from('friendships')
        .delete()
        .or(`and(sender_id.eq.${userId},receiver_id.eq.${friendId}),and(sender_id.eq.${friendId},receiver_id.eq.${userId})`);
    } else {
      await supabase
        .from('friendships')
        .delete()
        .or(`and(user_id.eq.${userId},friend_id.eq.${friendId}),and(user_id.eq.${friendId},friend_id.eq.${userId})`);
    }
  } catch (e) {
    console.warn('Error unfriending in DB:', e);
  }
};

export const addMessageReaction = async (messageId: string, userId: string, emoji: string | null) => {
  try {
    // Supabase attempt
    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
    if (!uuidRegex.test(messageId)) {
      console.warn('Invalid message ID format for reaction:', messageId);
      return;
    }

    // Supabase attempt
    // First fetch existing reactions to ensure we don't overwrite others
    const { data: existingMsg, error: fetchErr } = await supabase
      .from('messages')
      .select('reactions')
      .eq('id', messageId)
      .maybeSingle();

    if (fetchErr) {
      console.error('Error fetching existing reactions:', fetchErr.message || fetchErr);
      return;
    }

    const currentReactions = { ...(existingMsg?.reactions || {}) };
    if (emoji) {
      currentReactions[userId] = emoji;
    } else {
      delete currentReactions[userId];
    }

    const { error: updateErr } = await supabase
      .from('messages')
      .update({ reactions: currentReactions })
      .eq('id', messageId);
    
    if (updateErr) {
      console.error('Error updating reactions in DB:', updateErr);
    }
  } catch (e) {
    console.error('Critical error adding reaction:', e);
  }
};

export const clearAllChats = async (userId: string) => {
  console.log('[clearAllChats] Starting...', { userId });
  try {
    const now = new Date().toISOString();
    
    // 1. Mark as deleted locally first for ALL messages the user is involved in
    // This provides immediate feedback in the UI
    const localData = localStorage.getItem('chat_messages');
    if (localData) {
      const allMessages: Message[] = JSON.parse(localData);
      const userMessageIds = allMessages
        .filter(m => m.sender_id === userId || m.receiver_id === userId)
        .map(m => m.id);
      markAsDeletedLocally(userMessageIds);
      
      const filteredMessages = allMessages.filter(m => m.sender_id !== userId && m.receiver_id !== userId);
      localStorage.setItem('chat_messages', JSON.stringify(filteredMessages));
    }

    // Record a "cleared all" timestamp to quickly filter out older messages
    localStorage.setItem(`cleared_all_at_${userId}`, now);

    if (!isUUID(userId) || useLocalFallback) {
      console.log('[clearAllChats] Local only path taken.');
      return;
    }

    // Update DB profile if possible
    console.log('[clearAllChats] Updating Supabase profiles with cleared_all_at');
    const { error: profileError } = await supabase
      .from('profiles')
      .update({ cleared_all_at: now })
      .eq('id', userId);
    
    if (profileError) {
      console.warn('[clearAllChats] Supabase profiles update failed (possibly column missing):', profileError);
    }

    // 2. Fetch all IDs from Supabase to mark as deleted locally (to handle messages not in current local storage)
    try {
      console.log('[clearAllChats] Fetching all message IDs from Supabase for local marking');
      const { data, error: fetchError } = await supabase
        .from('messages')
        .select('id')
        .or(`sender_id.eq.${userId},receiver_id.eq.${userId}`);
      
      if (fetchError) throw fetchError;

      if (data && data.length > 0) {
        markAsDeletedLocally(data.map(m => m.id));
      }
    } catch (e) {
      console.warn('[clearAllChats] Could not fetch message IDs for marking as deleted locally:', e);
    }

    // 3. Supabase deletion
    // Using separate delete calls to be safer with different Supabase configurations
    console.log('[clearAllChats] Executing Supabase deletions for messages');
    const delete1 = await supabase.from('messages').delete().eq('sender_id', userId);
    if (delete1.error) console.error('[clearAllChats] Supabase delete sender_id error:', delete1.error);
    
    const delete2 = await supabase.from('messages').delete().eq('receiver_id', userId);
    if (delete2.error) console.error('[clearAllChats] Supabase delete receiver_id error:', delete2.error);
    
    console.log('[clearAllChats] Completed.');
  } catch (e) {
    console.error('[clearAllChats] Critical error:', e);
    throw e;
  }
};

export const deleteMessages = async (messageIds: string[]) => {
  try {
    // Mark as deleted locally first to ensure they disappear immediately
    markAsDeletedLocally(messageIds);

    const localData = localStorage.getItem('chat_messages');
    if (localData) {
      let allMessages: Message[] = JSON.parse(localData);
      allMessages = allMessages.filter(m => !messageIds.includes(m.id));
      localStorage.setItem('chat_messages', JSON.stringify(allMessages));
    }

    if (useLocalFallback) return;

    const { error } = await supabase
      .from('messages')
      .delete()
      .in('id', messageIds);
    
    if (error) {
      console.warn('Supabase delete failed (possibly due to RLS), but message is hidden locally:', error);
    }
  } catch (e) {
    console.warn('Error deleting messages:', e);
  }
};

export const clearChat = async (userId1: string, userId2: string) => {
  try {
    // Fetch current messages to mark them all as deleted locally
    const currentMessages = await getLocalMessages(userId1, userId2);
    const messageIds = currentMessages.map(m => m.id);
    markAsDeletedLocally(messageIds);

    const localData = localStorage.getItem('chat_messages');
    if (localData) {
      let allMessages: Message[] = JSON.parse(localData);
      allMessages = allMessages.filter(
        m => !((m.sender_id === userId1 && m.receiver_id === userId2) ||
               (m.sender_id === userId2 && m.receiver_id === userId1))
      );
      localStorage.setItem('chat_messages', JSON.stringify(allMessages));
    }

    if (useLocalFallback) return;

    const { error } = await supabase
      .from('messages')
      .delete()
      .or(`and(sender_id.eq.${userId1},receiver_id.eq.${userId2}),and(sender_id.eq.${userId2},receiver_id.eq.${userId1})`);
    
    if (error) {
      console.warn('Supabase clear chat failed (possibly due to RLS), but chat is cleared locally:', error);
    }
  } catch (e) {
    console.warn('Error clearing chat:', e);
  }
};

export const blockUser = async (userId: string, blockedId: string) => {
  console.log('[blockUser] Starting...', { userId, blockedId });
  alert("Block handler called");
  try {
    const localBlocked = getLocalBlocked();
    if (!localBlocked.includes(blockedId)) {
      localBlocked.push(blockedId);
      localStorage.setItem('chat_blocked_users', JSON.stringify(localBlocked));
    }

    if (isUUID(userId) && isUUID(blockedId)) {
      console.log('[blockUser] Inserting into Supabase blocked_users');
      const { error } = await supabase.from('blocked_users').insert({ user_id: userId, blocked_id: blockedId });
      if (error) {
        console.error('[blockUser] Supabase error:', error);
        alert(error.message);
        throw error;
      }
      alert("Block successful");
    } else {
      console.log('[blockUser] Skipping Supabase insert - not UUIDs', { userId, blockedId });
      alert("Block successful (local only)");
    }
    console.log('[blockUser] Completed.');
  } catch (e: any) {
    console.error('[blockUser] Critical error:', e);
    if (e.message) alert(e.message);
    throw e;
  }
};

export const unblockUser = async (userId: string, blockedId: string) => {
  console.log('[unblockUser] Starting...', { userId, blockedId });
  alert("Unblock handler called");
  try {
    const localBlocked = getLocalBlocked();
    const filtered = localBlocked.filter((id: string) => id !== blockedId);
    localStorage.setItem('chat_blocked_users', JSON.stringify(filtered));

    if (isUUID(userId) && isUUID(blockedId)) {
      console.log('[unblockUser] Deleting from Supabase blocked_users');
      const { error } = await supabase.from('blocked_users').delete().eq('user_id', userId).eq('blocked_id', blockedId);
      if (error) {
        console.error('[unblockUser] Supabase error:', error);
        alert(error.message);
        throw error;
      }
      alert("Unblock successful");
    } else {
      console.log('[unblockUser] Skipping Supabase delete - not UUIDs', { userId, blockedId });
      alert("Unblock successful (local only)");
    }
    console.log('[unblockUser] Completed.');
  } catch (e: any) {
    console.error('[unblockUser] Critical error:', e);
    if (e.message) alert(e.message);
    throw e;
  }
};

export const fetchBlockedUsers = async (userId: string): Promise<string[]> => {
  const localBlocked = getLocalBlocked();
  try {
    if (!isUUID(userId)) return localBlocked;

    const { data, error } = await supabase
      .from('blocked_users')
      .select('blocked_id')
      .eq('user_id', userId);

    if (error) {
      if (error.code === '42P01' || error.message?.includes('does not exist')) {
        return localBlocked;
      }
      throw error;
    }
    const remoteBlocked = (data || []).map(b => b.blocked_id);
    return Array.from(new Set([...localBlocked, ...remoteBlocked]));
  } catch (e) {
    console.warn('Error fetching blocked users, using local:', e);
    return localBlocked;
  }
};

export const isBlocked = async (userId: string, targetId: string): Promise<boolean> => {
  const blocked = await fetchBlockedUsers(userId);
  return blocked.includes(targetId);
};

export const isFriend = async (userId: string, targetUserId: string): Promise<boolean> => {
  const friendIds = await fetchActualFriendIds(userId);
  return friendIds.includes(targetUserId);
};

export const fetchActualFriendIds = async (userId: string): Promise<string[]> => {
  try {
    if (!isUUID(userId)) {
      const localFriendships = getLocalFriendships();
      return Array.from(new Set(localFriendships
        .filter((f: any) => f.sender_id === userId || f.receiver_id === userId)
        .map((f: any) => f.sender_id === userId ? f.receiver_id : f.sender_id)
        .filter((id): id is string => typeof id === 'string' && id !== userId && id.trim() !== '')
      ));
    }

    const version = await getFriendshipsSchemaVersion();
    let friendships: any[] | null = null;

    if (version === 'v3') {
      const { data } = await supabase
        .from('friendships')
        .select('user_id1, user_id2')
        .or(`user_id1.eq.${userId},user_id2.eq.${userId}`);
      friendships = data;
    } else if (version === 'v2') {
      const { data } = await supabase
        .from('friendships')
        .select('sender_id, receiver_id')
        .or(`sender_id.eq.${userId},receiver_id.eq.${userId}`);
      friendships = data;
    } else {
      const { data } = await supabase
        .from('friendships')
        .select('user_id, friend_id')
        .or(`user_id.eq.${userId},friend_id.eq.${userId}`);
      friendships = data;
    }

    if (!friendships) return [];

    const ids = friendships.map(f => {
      if (version === 'v3') {
        return f.user_id1 === userId ? f.user_id2 : f.user_id1;
      } else if (version === 'v2') {
        return f.sender_id === userId ? f.receiver_id : f.sender_id;
      } else {
        return f.user_id === userId ? f.friend_id : f.user_id;
      }
    });

    const uniqueIds = Array.from(new Set(ids.filter((id): id is string => 
      typeof id === 'string' && id !== userId && id.trim() !== ''
    )));

    if (uniqueIds.length === 0) return [];

    // CRITICAL: Only count as friends if they have a valid profile
    // This prevents "ghost" unread counts from users without profiles
    const { data: validProfiles } = await supabase
      .from('profiles')
      .select('id')
      .in('id', uniqueIds.filter(isUUID));

    const validIds = new Set(validProfiles?.map(p => p.id) || []);
    
    // Add back any non-UUID IDs (local users) if they were in uniqueIds
    uniqueIds.forEach(id => {
      if (!isUUID(id)) validIds.add(id);
    });

    return Array.from(validIds);
  } catch {
    return [];
  }
};

export const fetchUnreadMessageCount = async (userId: string): Promise<number> => {
  try {
    let localCount = 0;
    
    // Use the strict friend IDs function
    const friendIds = await fetchActualFriendIds(userId);
    const blockedUsers = await fetchBlockedUsers(userId);
    const allowedSenderIds = friendIds.filter(id => !blockedUsers.includes(id));

    const localData = localStorage.getItem('chat_messages');
    if (localData) {
      const allMessages: Message[] = JSON.parse(localData);
      localCount = allMessages.filter(m => 
        m.receiver_id === userId && 
        !m.is_read && 
        allowedSenderIds.includes(m.sender_id)
      ).length;
    }

    if (!isUUID(userId)) return localCount;
    if (allowedSenderIds.length === 0) return 0; // If no friends, no visible chat messages

    const { count, error } = await supabase
      .from('messages')
      .select('*', { count: 'exact', head: true })
      .eq('receiver_id', userId)
      .eq('is_read', false)
      .in('sender_id', allowedSenderIds);

    if (error) return localCount;
    return count || 0;
  } catch {
    return 0;
  }
};

export const markAllMessagesAsRead = async (userId: string) => {
  if (!userId) return;

  try {
    const localData = localStorage.getItem('chat_messages');
    if (localData) {
      try {
        const allMessages: Message[] = JSON.parse(localData);
        let changed = false;
        allMessages.forEach(m => {
          if (m.receiver_id === userId && !m.is_read) {
            m.is_read = true;
            changed = true;
          }
        });
        if (changed) {
          localStorage.setItem('chat_messages', JSON.stringify(allMessages));
        }
      } catch (err) {
        console.warn('Error parsing local messages:', err);
      }
    }

    if (isUUID(userId)) {
      const { error } = await supabase
        .from('messages')
        .update({ is_read: true })
        .match({ receiver_id: userId, is_read: false });
      
      if (error) {
        console.warn('Supabase mark all as read error:', error);
      }
    }
  } catch (e) {
    console.warn('Error in markAllMessagesAsRead:', e);
  }
};

export const markMessagesAsRead = async (userId: string, senderId: string) => {
  if (!userId || !senderId) return;
  
  try {
    // 1. Update local storage immediately for responsive feel
    const localData = localStorage.getItem('chat_messages');
    if (localData) {
      try {
        const allMessages: Message[] = JSON.parse(localData);
        let changed = false;
        allMessages.forEach(m => {
          if (m.receiver_id === userId && m.sender_id === senderId && !m.is_read) {
            m.is_read = true;
            changed = true;
          }
        });
        if (changed) {
          localStorage.setItem('chat_messages', JSON.stringify(allMessages));
        }
      } catch (err) {
        console.warn('Error parsing local messages:', err);
      }
    }

    // 2. Update Supabase
    if (isUUID(userId) && isUUID(senderId)) {
      const { error } = await supabase
        .from('messages')
        .update({ is_read: true })
        .match({ receiver_id: userId, sender_id: senderId, is_read: false });
      
      if (error) {
        console.warn('Supabase mark as read error:', error);
      }
    }
  } catch (e) {
    console.warn('Error in markMessagesAsRead:', e);
  }
};

export const markSingleMessageAsRead = async (messageId: string) => {
  try {
    const localData = localStorage.getItem('chat_messages');
    if (localData) {
      const allMessages: Message[] = JSON.parse(localData);
      const msgIndex = allMessages.findIndex(m => m.id === messageId);
      if (msgIndex !== -1) {
        allMessages[msgIndex].is_read = true;
        localStorage.setItem('chat_messages', JSON.stringify(allMessages));
      }
    }

    if (isUUID(messageId)) {
      await supabase
        .from('messages')
        .update({ is_read: true })
        .eq('id', messageId);
    }
  } catch (e) {
    console.warn('Error marking single message as read:', e);
  }
};

export const updateMessageContent = async (messageId: string, content: string) => {
  try {
    // 1. Update local storage
    const localData = localStorage.getItem('chat_messages');
    if (localData) {
      const allMessages: Message[] = JSON.parse(localData);
      const msgIndex = allMessages.findIndex(m => m.id === messageId);
      if (msgIndex !== -1) {
        allMessages[msgIndex].content = content;
        localStorage.setItem('chat_messages', JSON.stringify(allMessages));
      }
    }

    // 2. Update Supabase
    if (isUUID(messageId) || (messageId && !messageId.startsWith('temp-'))) {
      const { error } = await supabase
        .from('messages')
        .update({ content })
        .eq('id', messageId);
      
      if (error) throw error;
    }
  } catch (e) {
    console.warn('Error updating message content:', e);
    throw e;
  }
};

function getLocalBlocked(): string[] {
  try {
    const data = localStorage.getItem('chat_blocked_users');
    return data ? JSON.parse(data) : [];
  } catch {
    return [];
  }
}
